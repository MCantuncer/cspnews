// Live scores: a Cloudflare Worker on live.<site domain>. The site's pages ask it for the score
// of the matches on the Tonight list while they are played. See README.md for the one-time setup.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cspnews-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": false },
  // The Worker's own address; deploying creates its DNS record in the cspnews.app zone.
  // Only the custom domain serves the Worker: no workers.dev address, no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "live.cspnews.app", "custom_domain": true }],
  // The Daily Song board: one SQLite-backed Durable Object per game day (src/board.ts). Deploying
  // creates it; there is no database to set up.
  "durable_objects": { "bindings": [{ "name": "SONG_BOARD", "class_name": "SongBoard" }] },
  "migrations": [{ "tag": "song-board-1", "new_sqlite_classes": ["SongBoard"] }],
  "vars": {
    // Pages that may read the scores and the song board, comma-separated.
    "ALLOWED_ORIGINS": "https://www.cspnews.app,https://cspnews.app,http://localhost:4321",
  },
}
