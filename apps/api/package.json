{
  "name": "@cspnews/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply cspnews-accounts --local",
    "db:migrate:remote": "wrangler d1 migrations apply cspnews-accounts --remote",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cspnews/accounts": "workspace:*",
    "hono": "4.13.18",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
