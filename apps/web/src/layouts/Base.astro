---
import '../styles/base.css';

import Ruler from '../components/Ruler.astro';

import type { EditionHour } from '../lib/edition';
import { feedPath } from '../lib/feed';
import {
  absoluteUrl,
  languageAlternates,
  OG_LOCALE,
  pagePath,
  SHARE_FALLBACK,
  SHARE_SIZE,
} from '../lib/share';

interface Props {
  title: string;
  description?: string;
  hour?: EditionHour;
  /** The interface language. */
  lang?: 'en' | 'tr';
  /** The site path of the picture shown when the page is shared (src/lib/share.ts). */
  image?: string;
  /** `article` for a story, `website` for everything else. */
  kind?: 'article' | 'website';
}

const {
  title,
  description = 'A personal newsroom: four calm bulletins a day.',
  hour = 'dawn',
  lang = 'en',
  image = SHARE_FALLBACK,
  kind = 'website',
} = Astro.props;
// Pages are built once per language; the preview, canonical and language links use this one's address.
const { pathname } = Astro.url;
const address = absoluteUrl(pagePath(pathname));
const alternates = languageAlternates(pathname);
const picture = absoluteUrl(image);
---

<!doctype html>
<html lang={lang} data-hour={hour} data-theme="device">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={address} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:site_name" content="CSPNews" />
    <meta property="og:type" content={kind} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={address} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={picture} />
    {
      image === SHARE_FALLBACK && (
        <>
          <meta property="og:image:width" content={String(SHARE_SIZE.width)} />
          <meta property="og:image:height" content={String(SHARE_SIZE.height)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="CSPNews" href={feedPath(lang)} />
    <meta name="color-scheme" content="dark light" />
    <!-- The browser bar takes the page colour: Clean or Dark when matching the device (tokens.css). -->
    <meta
      name="theme-color"
      content="#fff"
      media="(prefers-color-scheme: light)"
      data-scheme="light"
      data-device="#fff"
    />
    <meta
      name="theme-color"
      content="#11100e"
      media="(prefers-color-scheme: dark)"
      data-scheme="dark"
      data-device="#11100e"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      // Apply saved reading settings before first paint, so the page never flashes the wrong theme.
      // A reader who chose a language in Settings stays on that side of the site (src/lib/locale.ts).
      try {
        const root = document.documentElement;
        const lang = localStorage.getItem('cspnews:lang');
        const path = location.pathname;
        const onTr = path === '/tr' || path.startsWith('/tr/');
        // The word game, account and privacy pages pick their language themselves (/word/tr,
        // /account/tr, /privacy/tr), so they never move.
        const fixed = /^\/(word|account|privacy)(\/|$)/.test(path);
        const rest = location.search + location.hash;
        if (!fixed && lang === 'tr' && !onTr) location.replace((path === '/' ? '/tr' : '/tr' + path) + rest);
        if (!fixed && lang === 'en' && onTr) location.replace((path.slice(3) || '/') + rest);
        const theme = localStorage.getItem('cspnews:theme');
        const size = localStorage.getItem('cspnews:text-size');
        // Page colours per chosen theme, the same as --bg in tokens.css (lib/themes.test.ts checks).
        const pageColour = { dark: '#11100e', black: '#000', light: '#f7f4ee', clean: '#fff' };
        if (theme && Object.hasOwn(pageColour, theme)) {
          root.dataset.theme = theme;
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.content = pageColour[theme];
            meta.removeAttribute('media');
          }
        }
        if (size === 'small' || size === 'large' || size === 'larger') root.dataset.textSize = size;
        if (localStorage.getItem('cspnews:ruler') === 'on') root.dataset.ruler = 'on';
        if (localStorage.getItem('cspnews:light') === 'off') root.dataset.light = 'off';
        // The accounts API's readable hint: show the avatar spot, not "Sign in", from the first paint.
        if (/(?:^|;\s*)cspn_signed_in=1(?:;|$)/.test(document.cookie)) root.dataset.signedIn = '';
      } catch {
        // Storage can be unavailable (private mode); the defaults still work.
      }
    </script>
  </head>
  <body>
    <slot />
    <Ruler />
  </body>
</html>
