---
import '../styles/base.css';

import Ruler from '../components/Ruler.astro';

import type { EditionHour } from '../lib/edition';

interface Props {
  title: string;
  description?: string;
  hour?: EditionHour;
  /** The interface language. */
  lang?: 'en' | 'tr';
}

const {
  title,
  description = 'A personal newsroom: four calm bulletins a day.',
  hour = 'dawn',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-hour={hour} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <script is:inline>
      // Apply saved reading settings before first paint, so the page never flashes the wrong theme.
      // A reader who chose a language in Settings stays on that side of the site (src/lib/locale.ts).
      try {
        const root = document.documentElement;
        const lang = localStorage.getItem('cspnews:lang');
        const path = location.pathname;
        const onTr = path === '/tr' || path.startsWith('/tr/');
        // The word game picks its puzzle language itself (/word, /word/tr), so it never moves.
        const fixed = path === '/word' || path.startsWith('/word/');
        const rest = location.search + location.hash;
        if (!fixed && lang === 'tr' && !onTr) location.replace((path === '/' ? '/tr' : '/tr' + path) + rest);
        if (!fixed && lang === 'en' && onTr) location.replace((path.slice(3) || '/') + rest);
        const theme = localStorage.getItem('cspnews:theme');
        const size = localStorage.getItem('cspnews:text-size');
        if (theme === 'light' || theme === 'device') root.dataset.theme = theme;
        if (size === 'small' || size === 'large' || size === 'larger') root.dataset.textSize = size;
        if (localStorage.getItem('cspnews:ruler') === 'on') root.dataset.ruler = 'on';
      } catch {
        // Storage can be unavailable (private mode); the defaults still work.
      }
    </script>
  </head>
  <body>
    <slot />
    <Ruler />
  </body>
</html>
