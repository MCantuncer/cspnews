---
/**
 * The evidence drawer (docs/design/system.md, "Evidence drawer"): what the label means, then
 * the camp map, one row per camp with a large count and each outlet by logo, name and a
 * three-step reliability meter. A bottom sheet on phones, a right panel on wide screens.
 * Built on the popover attribute, so it opens, closes on Esc and on a tap outside, without
 * any script.
 */
import type { Section, StorySource } from '@cspnews/core';

import { campMap, labelMeaning } from '../../lib/camps';
import type { EvidenceLabel, InterfaceLanguage } from '../../lib/evidence';
import { outletCount, reliabilityLabel, wordsFor } from '../../lib/i18n';
import { outletLogoUrl } from '../../lib/media';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  id: string;
  label: EvidenceLabel;
  sources: readonly StorySource[];
  section: Section;
  lang: InterfaceLanguage;
}

const { id, label, sources, section, lang } = Astro.props;
const words = wordsFor(lang);
const rows = campMap(sources, section, lang);
const total = rows.reduce((sum, row) => sum + row.count, 0);
---

<div class="drawer" id={id} popover role="dialog" aria-labelledby={`${id}-title`}>
  <div class="head">
    <h2 id={`${id}-title`} class="title"><EvidenceMark label={label} lang={lang} /></h2>
    <button
      type="button"
      class="close"
      popovertarget={id}
      popovertargetaction="hide"
      aria-label={words.close}
    >
      <Icon name="close" />
    </button>
  </div>
  <p class="meaning">{labelMeaning(label, lang)}</p>

  <h3 class="who">{words.whoReports}<span class="total">{outletCount(total, lang)}</span></h3>
  <ol class="camps">
    {
      rows.map((row) => (
        <li class:list={['camp', { empty: row.outlets.length === 0 }]}>
          <span class="count" aria-hidden="true">
            {row.count}
          </span>
          <div class="camp-body">
            <h4 class="camp-name">
              {row.name}
              <span class="visually-hidden">, {outletCount(row.count, lang)}</span>
            </h4>
            {row.outlets.length === 0 ? (
              <p class="none">{words.noOutlet}</p>
            ) : (
              <ul class="outlets">
                {row.outlets.map((outlet) => {
                  const logo = outletLogoUrl(outlet.sourceId);
                  return (
                    <li class:list={['outlet', { copy: !outlet.confirms }]}>
                      <a href={outlet.url} rel="noopener noreferrer">
                        {logo ? (
                          <img class="logo" src={logo} alt="" width="20" height="20" loading="lazy" />
                        ) : (
                          <Icon name="slot" size={20} class="logo-slot" />
                        )}
                        <span class="name">
                          {outlet.name}
                          {!outlet.confirms && <span class="copy-note">, {words.republished}</span>}
                        </span>
                        <span
                          class="meter"
                          role="img"
                          aria-label={reliabilityLabel(outlet.steps, lang)}
                          data-steps={outlet.steps}
                        >
                          <i />
                          <i />
                          <i />
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .drawer {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    max-height: 88dvh;
    margin: 0;
    padding: 8px var(--gutter) max(28px, env(safe-area-inset-bottom));
    overflow-y: auto;
    border: 0;
    border-top: 3px solid var(--hour);
    border-radius: 16px 16px 0 0;
    background: var(--surf);
    color: var(--ink2);
    overscroll-behavior: contain;
  }

  .drawer::backdrop {
    background: var(--scrim);
  }

  @media (width >= 1024px) {
    .drawer {
      inset: 0 0 0 auto;
      width: 440px;
      height: 100dvh;
      max-height: none;
      padding: 16px 32px 32px;
      border-top: 0;
      border-left: 3px solid var(--hour);
      border-radius: 0;
    }
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
  }

  .title :global(.ev) {
    font-size: 20px;
  }

  .title :global(.ev__g) {
    width: 24px;
    height: 24px;
  }

  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .meaning {
    max-width: 38em;
    color: var(--ink);
    font: 400 17px / 1.5 var(--f-body);
  }

  .who {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    font: 700 16px / 1.3 var(--f-body);
    letter-spacing: 0;
  }

  .total {
    color: var(--meta);
    font-weight: 500;
  }

  .camps,
  .outlets {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .camp {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .count {
    color: var(--ink);
    font: 800 34px / 1 var(--f-head);
    font-variant-numeric: proportional-nums lining-nums;
  }

  .empty .count {
    color: var(--faint);
  }

  .camp-name {
    color: var(--ink);
    font: 700 16px / 1.3 var(--f-body);
    letter-spacing: 0;
  }

  .none {
    margin-top: 4px;
    color: var(--meta);
    font: 400 15px / 1.4 var(--f-body);
  }

  .outlets {
    margin-top: 4px;
  }

  .outlet a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font: 500 16px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .outlet a:hover .name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .logo {
    flex: none;
    border-radius: 4px;
    object-fit: contain;
  }

  .outlet :global(.logo-slot) {
    color: var(--faint);
  }

  .name {
    flex: 1;
    min-width: 0;
  }

  .copy .name {
    color: var(--meta);
  }

  .copy-note {
    font-size: 14px;
  }

  /* Three steps, filled by reliability. */
  .meter {
    display: flex;
    flex: none;
    gap: 3px;
  }

  .meter i {
    width: 10px;
    height: 4px;
    border-radius: 1px;
    background: var(--line2);
    opacity: 0.45;
  }

  .meter[data-steps='1'] i:nth-child(-n + 1),
  .meter[data-steps='2'] i:nth-child(-n + 2),
  .meter[data-steps='3'] i:nth-child(-n + 3) {
    background: var(--ink);
    opacity: 1;
  }
</style>
