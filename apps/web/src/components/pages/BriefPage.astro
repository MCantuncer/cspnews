---
/**
 * A bulletin in one minute (docs/design/decisions/in-one-minute.md): every story as its short
 * title and the one sentence that says what happened, with its evidence mark and a small square
 * of its picture beside it. Each line opens the full story; the end leads back to the whole
 * bulletin.
 */
import Header from '../Header.astro';
import HotLine from '../hot/HotLine.astro';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';
import NextEdition from '../ui/NextEdition.astro';
import VisualView from '../visual/Visual.astro';
import Base from '../../layouts/Base.astro';
import {
  bulletinPath,
  storiesBySection,
  storyPath,
  type PublishedBulletin,
} from '../../lib/bulletins';
import { editionHourFor } from '../../lib/edition';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatLongDate } from '../../lib/format';
import { bulletinName, sectionName, wordsFor } from '../../lib/i18n';
import { outletLogos } from '../../lib/media';
import { storyVisual } from '../../lib/story-visual';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const words = wordsFor(lang);
const name = bulletinName(published.slot, lang);
const groups = storiesBySection(published, lang);
---

<Base
  title={`${words.brief}: ${name}, ${formatLongDate(published.bulletin.publishAt, lang)} | CSPNews`}
  hour={editionHourFor(published.slot)}
  lang={lang}
>
  <Header
    lang={lang}
    bulletinName={name}
    contentsHref={bulletinPath(published, lang)}
    contentsLabel={words.contents}
  />
  <HotLine lang={lang} />
  <main class="brief">
    <h1>{words.brief}</h1>
    <p class="meta">{name}, {formatLongDate(published.bulletin.publishAt, lang)}. {words.briefHint}</p>

    {
      groups.map((group) => (
        <section data-section={group.section}>
          <h2>{sectionName(group.section, lang)}</h2>
          <ol>
            {group.stories.map(({ story }) => {
              const visual = storyVisual(story);
              // Without a picture, chart, map or logo of its own, the lead outlet's logo stands in.
              const [outlet] = visual.kind === 'none' ? outletLogos(story.sources, 1) : [];
              return (
                <li>
                  <a href={storyPath(published, story, lang)} lang={story.language}>
                    {visual.kind !== 'none' && (
                      <span class="thumb" aria-hidden="true">
                        <VisualView visual={visual} lang={lang} storyLang={story.language} size="thumb" />
                      </span>
                    )}
                    {outlet && (
                      <span class="thumb logo-thumb" aria-hidden="true">
                        <img src={outlet.src} alt="" loading="lazy" decoding="async" />
                      </span>
                    )}
                    <span class="title">
                      <EvidenceMark label={story.label} lang={lang} variant="glyph" />
                      {story.shortTitle}
                    </span>
                    <span class="what">{story.summary.what}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }

    <p class="end"><b>{words.endOfBulletin}.</b>{' '}<NextEdition published={published} lang={lang} /></p>
    <a class="way" href={bulletinPath(published, lang)}>
      <Icon name="contents" size={20} />
      <span>{words.fullBulletin}</span>
    </a>
  </main>
</Base>

<style>
  .brief {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
  }

  h1 {
    font: 800 32px / 1.08 var(--f-head);
    letter-spacing: -0.03em;
  }

  .meta {
    margin-top: 8px;
    color: var(--meta);
    font: 400 16px / 1.5 var(--f-body);
  }

  h2 {
    margin-top: 40px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--sec);
    color: var(--sec);
    font: 800 20px / 1.2 var(--f-head);
    letter-spacing: -0.015em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  /* flow-root keeps the floated picture inside its line. */
  li a {
    display: flow-root;
    padding: 16px 0;
    color: var(--ink);
    text-decoration: none;
  }

  /* The picture floats beside the title; the sentence wraps under it once it ends. */
  .thumb {
    display: grid;
    float: right;
    place-items: center;
    margin-left: 16px;
    margin-bottom: 6px;
    width: 84px;
    height: 84px;
    margin-top: 4px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--surf);
  }

  .thumb :global(.visual.thumb),
  .thumb :global(.visual.thumb img),
  .thumb :global(.visual.thumb svg) {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Logos are drawn for white, so they sit on white in both themes. */
  .logo-thumb {
    background: #fff;
  }

  .logo-thumb img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .title {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font: 700 18px / 1.3 var(--f-body);
  }

  /* The mark stays on the title's first line when the title wraps. */
  .title :global(.ev) {
    flex: none;
    margin-top: 3px;
  }

  li a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .what {
    display: block;
    margin-top: 6px;
    font: 400 17px / 1.5 var(--f-body);
  }

  .end {
    margin-top: 40px;
    color: var(--meta);
    font: 500 16px / 1.4 var(--f-body);
  }

  .end b {
    color: var(--ink);
    font-weight: 700;
  }

  .way {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    margin-top: 16px;
    padding: 12px 16px;
    border: 1.5px solid var(--line2);
    border-radius: 12px;
    color: var(--ink);
    font: 600 16px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .way:hover {
    border-color: var(--ink);
  }

  @media (width >= 1024px) {
    .brief {
      padding-top: 56px;
    }

    .thumb {
      width: 112px;
      height: 112px;
    }

    h1 {
      font-size: 40px;
    }
  }
</style>
