---
/**
 * One transfer (docs/design/decisions/transfers.md): the clubs, how far the move has gone on
 * the four-stage track with the day each stage was reached, where it stands now, at most two
 * numbers, who is saying it, and what would make it signed.
 */
import { TRANSFER_STAGES, transferIn, type TransferMove } from '@cspnews/core';

import Header from '../Header.astro';
import HotLine from '../hot/HotLine.astro';
import Icon from '../ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import { bulletinPath, type PublishedBulletin } from '../../lib/bulletins';
import { editionHourFor } from '../../lib/edition';
import type { InterfaceLanguage } from '../../lib/evidence';
import {
  extrasWords,
  leagueName,
  stageNumber,
  stageWord,
  transferReporters,
} from '../../lib/extras';
import { formatShortDate } from '../../lib/format';
import { photoUrl } from '../../lib/media';
import { bulletinName, wordsFor } from '../../lib/i18n';

interface Props {
  published: PublishedBulletin;
  move: TransferMove;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const move = transferIn(Astro.props.move, lang);
const words = wordsFor(lang);
const extras = extrasWords(lang);
const name = bulletinName(published.slot, lang);
const reached = stageNumber(move.stage);
const stepOn = new Map(move.steps.map((step) => [step.stage, step.on]));
const reporters = transferReporters(move);
const photo = move.image ? photoUrl(move.id) : undefined;
---

<Base
  title={`${move.title} | CSPNews`}
  description={move.now}
  hour={editionHourFor(published.slot)}
  lang={lang}
>
  <Header
    lang={lang}
    bulletinName={name}
    contentsHref={bulletinPath(published, lang)}
    contentsLabel={words.contents}
  />
  <HotLine lang={lang} />
  <main class="move" data-section="transfers" lang={move.language}>
    <a class="back" href={bulletinPath(published, lang)}>
      <Icon name="back" size={18} />
      {words.backToBulletin}
    </a>
    <p class="kicker">{extras.transfers}, {leagueName(move.league, lang)}</p>
    <h1>{move.title}</h1>
    <p class="clubs">
      {move.from}
      <Icon name="next" size={18} />
      {move.to}
    </p>

    {
      photo && move.image && (
        <figure class="photo">
          <img src={photo} alt="" decoding="async" />
          <figcaption>{`${words.photo}: ${move.image.sourceName}`}</figcaption>
        </figure>
      )
    }

    <ol class="track" style={`--done: ${String(reached / (TRANSFER_STAGES.length - 1))}`}>
      {
        TRANSFER_STAGES.map((stage, i) => {
          const on = stepOn.get(stage);
          return (
            <li class:list={{ on: i <= reached, now: i === reached }} aria-current={i === reached ? 'step' : undefined}>
              <i aria-hidden="true" />
              <b>{stageWord(stage, lang)}</b>
              <span>{on ? formatShortDate(on, lang) : ''}</span>
            </li>
          );
        })
      }
    </ol>

    <p class="status">{move.now}</p>
    {
      move.story && (
        <div class="story">
          {move.story.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )
    }
    {move.clubConfirmed && <p class="club"><Icon name="confirmed" size={18} />{extras.clubConfirmed}</p>}

    {
      move.facts && move.facts.length > 0 && (
        <dl class="facts">
          {move.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <h2>{extras.who}</h2>
    <p class="note">{extras.whoNote}</p>
    <ul class="reporters">
      {
        reporters.map((report) => (
          <li>
            <a href={report.url} rel="noopener">{report.name}</a>
            <span>{extras.reported(stageWord(report.stage, lang), formatShortDate(report.on, lang))}</span>
          </li>
        ))
      }
    </ul>

    {
      move.signedWhen && (
        <>
          <h2>{extras.signedWhen}</h2>
          <p class="signed-when">{move.signedWhen}</p>
        </>
      )
    }
  </main>
</Base>

<style>
  .move {
    max-width: 640px;
    margin: 0 auto;
    padding: 28px var(--gutter) 56px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--meta);
    font: 500 15px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .kicker {
    margin-top: 10px;
    color: var(--sec);
    font: 700 14px / 1.2 var(--f-body);
  }

  h1 {
    margin-top: 8px;
    color: var(--ink);
    font: 800 28px / 1.12 var(--f-head);
    letter-spacing: -0.025em;
  }

  .clubs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    color: var(--ink2);
    font: 600 17px / 1.3 var(--f-body);
  }

  .clubs :global(svg) {
    color: var(--sec);
  }

  /* The four stages as stations on a line, filled up to where the move is. */
  .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .track::before,
  .track::after {
    position: absolute;
    top: 7px;
    left: 12.5%;
    height: 2px;
    content: '';
  }

  .track::before {
    right: 12.5%;
    background: var(--faint);
  }

  .track::after {
    width: calc(75% * var(--done));
    background: var(--sec);
  }

  .track li {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }

  .track i {
    width: 16px;
    height: 16px;
    border: 2px solid var(--faint);
    border-radius: 50%;
    background: var(--bg);
  }

  .track .on i {
    border-color: var(--sec);
    background: var(--sec);
  }

  .track .now i {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--sec) 28%, transparent);
  }

  .track b {
    color: var(--meta);
    font: 600 14px / 1.2 var(--f-body);
  }

  .track .on b {
    color: var(--ink);
  }

  .track span {
    min-height: 16px;
    color: var(--meta);
    font: 400 13px / 1.2 var(--f-body);
  }

  .status {
    margin-top: 22px;
    color: var(--ink);
    font: 600 19px / 1.5 var(--f-body);
  }

  .photo {
    margin: 22px 0 0;
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    object-fit: cover;
    background: var(--surf);
  }

  .photo figcaption {
    margin-top: 6px;
    color: var(--meta);
    font: 400 13px / 1.3 var(--f-body);
  }

  /* The story of the move, in the same reading text as a story page. */
  .story {
    display: grid;
    gap: 14px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .story p {
    color: var(--ink);
    font: 400 18px / 1.65 var(--f-body);
  }

  .club {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--conf);
    font: 600 15px / 1.3 var(--f-body);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 22px 0 0;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  .facts dd {
    margin: 0;
    color: var(--ink);
    font: 800 26px / 1.1 var(--f-head);
    letter-spacing: -0.02em;
  }

  .facts dt {
    margin-top: 4px;
    color: var(--meta);
    font: 400 14px / 1.35 var(--f-body);
  }

  h2 {
    margin-top: 30px;
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    letter-spacing: -0.015em;
  }

  .note {
    margin-top: 6px;
    color: var(--meta);
    font: 400 14px / 1.4 var(--f-body);
  }

  .reporters {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .reporters li {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .reporters a {
    color: var(--ink);
    font: 600 16px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .reporters a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reporters span {
    color: var(--meta);
    font: 400 14px / 1.3 var(--f-body);
  }

  .signed-when {
    margin-top: 10px;
    color: var(--ink2);
    font: 400 16px / 1.55 var(--f-body);
  }

  @media (width >= 1100px) {
    .move {
      max-width: 720px;
      padding-top: 56px;
    }

    h1 {
      font-size: 40px;
    }
  }
</style>
