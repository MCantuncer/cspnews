---
/**
 * Settings (design 07): interface language, theme, text size, the reading ruler, light stories
 * and the evidence legend. Everything is kept in this browser and applies at once.
 */
import Header from '../Header.astro';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';
import Toggle from '../ui/Toggle.astro';
import Base from '../../layouts/Base.astro';
import { aboutPath, aboutText } from '../../lib/about';
import { loadBulletins } from '../../lib/bulletins';
import { editionHourFor } from '../../lib/edition';
import { EVIDENCE_LABEL_VALUES } from '@cspnews/core';

import type { InterfaceLanguage } from '../../lib/evidence';
import { extrasWords } from '../../lib/extras';
import { wordsFor } from '../../lib/i18n';
import { INTERFACE_LANGUAGES, localePath } from '../../lib/locale';
import { TEXT_SIZES, THEMES } from '../../lib/settings';

interface Props {
  lang: InterfaceLanguage;
}

const { lang } = Astro.props;
const words = wordsFor(lang);
const extras = extrasWords(lang);
const latest = loadBulletins()[0];
const LANGUAGE_NAMES = { en: 'English', tr: 'Türkçe' } as const;
const sizeLabels = Object.fromEntries(
  TEXT_SIZES.map((size) => [size.id, `${words.textSizes[size.id]}, ${String(size.px)}px`]),
);
---

<Base
  title={`${words.settings} | CSPNews`}
  hour={latest ? editionHourFor(latest.slot) : 'dawn'}
  lang={lang}
>
  <Header lang={lang} inSettings />
  <main class="page" data-settings>
    <h1>{words.settings}</h1>

    <section class="group" aria-labelledby="set-language">
      <h2 id="set-language"><Icon name="language" size={22} />{words.language}</h2>
      <p class="hint">{words.languageHint}</p>
      <div class="options" role="radiogroup" aria-labelledby="set-language">
        {
          INTERFACE_LANGUAGES.map((option) => (
            <a
              class="option"
              role="radio"
              aria-checked={option === lang ? 'true' : 'false'}
              href={localePath('/settings', option)}
              lang={option}
              data-lang-option={option}
            >
              {LANGUAGE_NAMES[option]}
              {option === lang && <Icon name="tick" size={22} />}
            </a>
          ))
        }
      </div>
    </section>

    <section class="group" aria-labelledby="set-theme">
      <h2 id="set-theme"><Icon name="theme" size={22} />{words.theme}</h2>
      <div class="options" role="radiogroup" aria-labelledby="set-theme">
        {
          THEMES.map((theme) => (
            <button
              type="button"
              class="option"
              role="radio"
              aria-checked={theme === 'dark' ? 'true' : 'false'}
              data-theme-option={theme}
            >
              {words.themes[theme]}
              <Icon name="choice-off" size={24} class="off" />
              <Icon name="choice-on" size={24} class="on" />
            </button>
          ))
        }
      </div>
    </section>

    <section class="group" aria-labelledby="set-size">
      <h2 id="set-size"><Icon name="text-size" size={22} />{words.textSize}</h2>
      <div class="size" data-size={JSON.stringify(sizeLabels)}>
        <button type="button" class="step small" aria-label={words.smallerText} data-step="-1">
          A
        </button>
        <output class="value" aria-live="polite">{sizeLabels['default']}</output>
        <button type="button" class="step large" aria-label={words.largerText} data-step="1">
          A
        </button>
      </div>
    </section>

    <div class="group switch">
      <div class="switch-text">
        <h2 id="set-ruler"><Icon name="ruler" size={22} />{words.ruler}</h2>
        <p class="hint">{words.rulerHint}</p>
      </div>
      <Toggle label={words.ruler} id="ruler-toggle" name="ruler" />
    </div>

    <div class="group switch">
      <div class="switch-text">
        <h2 id="set-light"><Icon name="light" size={22} />{extras.lightSetting}</h2>
        <p class="hint">{extras.lightHint}</p>
      </div>
      <Toggle label={extras.lightSetting} id="light-toggle" name="light" checked />
    </div>

    <section class="group" aria-labelledby="set-evidence">
      <h2 id="set-evidence"><Icon name="none" size={22} />{words.evidenceMarks}</h2>
      <p class="legend">
        {EVIDENCE_LABEL_VALUES.map((label) => <EvidenceMark label={label} lang={lang} />)}
        <span class="none"><Icon name="none" size={18} />{words.noneYet}</span>
      </p>
      <a class="about" href={aboutPath(lang)}>
        <span>{aboutText(lang).linkLabel}</span>
        <Icon name="more" size={20} />
      </a>
    </section>
  </main>
</Base>

<script>
  import { bindSettings } from '../../lib/settings-ui';

  const page = document.querySelector<HTMLElement>('[data-settings]');
  if (page) bindSettings(page);
</script>

<style>
  .about {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    margin-top: 16px;
    padding: 12px 16px;
    border: 1.5px solid var(--line2);
    border-radius: 12px;
    color: var(--ink);
    font: 600 16px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .about:hover {
    border-color: var(--ink);
  }

  .page {
    max-width: 640px;
    margin: 0 auto;
    padding: 28px var(--gutter) 64px;
  }

  h1 {
    font: 800 34px / 1.1 var(--f-head);
    letter-spacing: -0.022em;
  }

  .group {
    padding-top: 28px;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font: 700 16px / 1.3 var(--f-body);
    letter-spacing: 0;
  }

  .hint {
    margin: 4px 0 0 32px;
    color: var(--meta);
    font: 500 15px / 1.45 var(--f-body);
  }

  .options {
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }

  .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink);
    font: 500 17px / 1.2 var(--f-body);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .option[aria-checked='true'] {
    font-weight: 700;
  }

  .option :global(.icon) {
    color: var(--meta);
  }

  .option :global(.on),
  .option[aria-checked='true'] :global(.off) {
    display: none;
  }

  .option[aria-checked='true'] :global(.on) {
    display: block;
    color: var(--hour);
  }

  .option[aria-checked='true'] :global(.icon) {
    color: var(--ink);
  }

  .option[aria-checked='true'] :global(.on.icon) {
    color: var(--hour);
  }

  .size {
    display: grid;
    grid-template-columns: 52px 1fr 52px;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .step {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1.5px solid var(--line2);
    border-radius: 12px;
    background: none;
    color: var(--ink);
    font-family: var(--f-body);
    font-weight: 700;
    cursor: pointer;
  }

  .step:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .step.small {
    font-size: 15px;
  }

  .step.large {
    font-size: 22px;
  }

  .value {
    color: var(--ink);
    font: 500 17px / 1.2 var(--f-body);
    text-align: center;
  }

  .switch {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin-top: 14px;
  }

  .none {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--meta);
    font: 600 14px / 1 var(--f-body);
  }

  @media (width >= 1024px) {
    .page {
      padding-top: 48px;
    }
  }
</style>
