---
/**
 * One Spotlight (Magazin) story on its own page (docs/design/decisions/and-finally.md): the
 * kind, the headline, the outlet photo, the gist as the lead, our story in a few paragraphs, the
 * one line of wit under the hour rule, and where we read it. The reader stays on CSPNews; the
 * outlets are linked at the end.
 */
import { lightIn, type LightStory } from '@cspnews/core';

import Header from '../Header.astro';
import HotLine from '../hot/HotLine.astro';
import EvidenceMark from '../ui/EvidenceMark.astro';
import ShareButton from '../story/ShareButton.astro';
import Icon from '../ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import { bulletinPath, type PublishedBulletin } from '../../lib/bulletins';
import { editionHourFor } from '../../lib/edition';
import type { InterfaceLanguage } from '../../lib/evidence';
import { AND_FINALLY_ID, LIGHT_KIND_ICON, extrasWords, kindWord } from '../../lib/extras';
import { bulletinName, wordsFor } from '../../lib/i18n';
import { logosFor, photoUrl } from '../../lib/media';
import { sourceName } from '../../lib/sources';
import { shareImagePath } from '../../lib/share';

interface Props {
  published: PublishedBulletin;
  story: LightStory;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const story = lightIn(Astro.props.story, lang);
const words = wordsFor(lang);
const extras = extrasWords(lang);
const name = bulletinName(published.slot, lang);
const photo = story.image ? photoUrl(story.id) : undefined;
const back = `${bulletinPath(published, lang)}#${AND_FINALLY_ID}`;
const logoOf = (sourceId: string) => logosFor([sourceId], 1)[0];
---

<Base
  title={`${story.title} | CSPNews`}
  description={story.gist}
  image={shareImagePath(story.id)}
  kind="article"
  hour={editionHourFor(published.slot)}
  lang={lang}
>
  <Header
    lang={lang}
    bulletinName={name}
    contentsHref={bulletinPath(published, lang)}
    contentsLabel={words.contents}
  />
  <HotLine lang={lang} />
  <main class="spot" lang={story.language}>
    <a class="back" href={back}>
      <Icon name="back" size={18} />
      {extras.andFinally}
    </a>
    <p class="kicker">
      <span class="badge" aria-hidden="true">
        <Icon name={LIGHT_KIND_ICON[story.kind]} size={18} />
      </span>
      {kindWord(story.kind, lang)}
    </p>
    <h1>{story.title}</h1>

    {
      photo && story.image && (
        <figure class="photo">
          <img src={photo} alt="" decoding="async" />
          <figcaption>{`${words.photo}: ${story.image.sourceName}`}</figcaption>
        </figure>
      )
    }

    <p class="lead">{story.gist}</p>
    {
      story.story && (
        <div class="story">
          {story.story.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )
    }
    <p class="aside">{story.aside}</p>

    <ShareButton label={words.share} copied={words.linkCopied} title={story.title} />

    <h2>{extras.readAt}</h2>
    <p class="note">{extras.readAtNote}</p>
    <p class="label"><EvidenceMark label={story.label} lang={lang} /></p>
    <ul class="sources">
      {
        story.sources.map((source) => {
          const logo = logoOf(source.sourceId);
          return (
            <li>
              <a href={source.url} target="_blank" rel="noopener">
                {logo && <img src={logo.src} alt="" loading="lazy" decoding="async" />}
                {sourceName(source.sourceId)}
                <Icon name="external" size={16} />
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</Base>

<style>
  .spot {
    max-width: 640px;
    margin: 0 auto;
    padding: 28px var(--gutter) 56px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--meta);
    font: 500 15px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    color: var(--hour);
    font: 700 14px / 1.2 var(--f-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--hour) 14%, var(--bg));
  }

  h1 {
    margin-top: 12px;
    color: var(--ink);
    font: 800 28px / 1.12 var(--f-head);
    letter-spacing: -0.025em;
  }

  .photo {
    margin: 22px 0 0;
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    object-fit: cover;
    background: var(--surf);
  }

  .photo figcaption {
    margin-top: 6px;
    color: var(--meta);
    font: 400 13px / 1.3 var(--f-body);
  }

  .lead {
    margin-top: 22px;
    color: var(--ink);
    font: 600 19px / 1.5 var(--f-body);
  }

  /* Our story, in the same reading text as a story page. */
  .story {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .story p {
    color: var(--ink);
    font: 400 18px / 1.65 var(--f-body);
  }

  /* The one line of wit, under the hour rule as in the fold, so the joke is always marked. */
  .aside {
    margin-top: 24px;
    padding-left: 16px;
    border-left: 2px solid var(--hour);
    color: var(--ink);
    font: 700 19px / 1.4 var(--f-head);
  }

  h2 {
    margin-top: 34px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    letter-spacing: -0.015em;
  }

  .note {
    margin-top: 6px;
    color: var(--meta);
    font: 400 14px / 1.4 var(--f-body);
  }

  .label {
    margin-top: 12px;
  }

  .sources {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .sources li {
    border-top: 1px solid var(--line);
  }

  .sources a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    color: var(--ink);
    font: 600 16px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .sources a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sources img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }

  .sources :global(svg) {
    margin-left: auto;
    color: var(--meta);
  }

  @media (width >= 1100px) {
    .spot {
      max-width: 720px;
      padding-top: 56px;
    }

    h1 {
      font-size: 40px;
    }
  }
</style>
