---
/**
 * A Hot News story between bulletins (design 05b): Developing with its last update, the lead
 * outlet's headline, the evidence, the story so far and the outlets. The feed changes every
 * few minutes, so this page reads it in the browser; `?id=` names the story.
 */
import Header from '../Header.astro';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/timeline.css';
import type { InterfaceLanguage } from '../../lib/evidence';
import { wordsFor } from '../../lib/i18n';
import { localePath } from '../../lib/locale';

interface Props {
  lang: InterfaceLanguage;
}

const { lang } = Astro.props;
const home = localePath('/', lang);
const words = wordsFor(lang);
---

<Base title={`${words.hotNews} | CSPNews`} lang={lang}>
  <Header lang={lang} bulletinName={words.hotNews} />
  <main class="page" data-hot-page data-lang={lang}>
    <p class="state" data-state="loading">{words.hotLoading}</p>
    <div class="state" data-state="gone" hidden>
      <p>{words.hotGone}</p>
      <a class="action" href={home}>{words.backToBulletin}</a>
    </div>
    <div class="state" data-state="error" hidden>
      <p>{words.hotError}</p>
      <button type="button" class="action" data-retry>{words.tryAgain}</button>
    </div>

    <article data-state="story" hidden>
      <p class="status">
        <span class="developing"><Icon name="developing" size={20} />{words.developing}</span>
        <span class="updated"><Icon name="updated" size={20} /><span data-field="updated"></span></span>
      </p>
      <h1 data-field="title"></h1>
      <p class="evidence">
        <span data-mark="confirmed" hidden><EvidenceMark label="confirmed" lang={lang} /></span>
        <span data-mark="reported" hidden><EvidenceMark label="reported" lang={lang} /></span>
        <span class="outlets" data-field="outlets"></span>
      </p>

      <div data-field="timeline"></div>

      <section class="sources">
        <h2>{words.sources}</h2>
        <ul data-field="sources"></ul>
      </section>

      <a class="back" href={home}><Icon name="back" />{words.backToBulletin}</a>
    </article>
  </main>
</Base>

<script>
  import { formatTime } from '../../lib/format';
  import { loadHotFeed, safeUrl } from '../../lib/hot';
  import { updatedAt, wordsFor } from '../../lib/i18n';
  import { outletNames, sourceName } from '../../lib/sources';
  import { timelineFor } from '../../lib/timeline';
  import { closeTimelinesOnClick, timelineElement } from '../../lib/timeline-view';

  closeTimelinesOnClick();

  const page = document.querySelector<HTMLElement>('[data-hot-page]');
  const field = (name: string) => page?.querySelector<HTMLElement>(`[data-field="${name}"]`);

  function show(state: 'loading' | 'gone' | 'error' | 'story') {
    for (const el of page?.querySelectorAll<HTMLElement>('[data-state]') ?? []) {
      el.hidden = el.getAttribute('data-state') !== state;
    }
  }

  async function render() {
    if (!page) return;
    const lang = page.getAttribute('data-lang') === 'tr' ? 'tr' : 'en';
    show('loading');
    const feed = await loadHotFeed();
    if (!feed) {
      show('error');
      return;
    }
    const id = new URLSearchParams(location.search).get('id');
    const story = feed.stories.find((s) => s.id === id);
    if (!story) {
      show('gone');
      return;
    }

    const title = field('title');
    if (title) {
      title.textContent = story.title;
      title.lang = story.language;
    }
    document.title = `${story.shortTitle} | CSPNews`;
    const updated = field('updated');
    if (updated) updated.textContent = updatedAt(formatTime(story.updatedAt, lang), lang);
    for (const mark of page.querySelectorAll<HTMLElement>('[data-mark]')) {
      mark.hidden = mark.getAttribute('data-mark') !== story.label;
    }
    const outlets = field('outlets');
    if (outlets) outlets.textContent = outletNames(story.sources).join(', ');

    const slot = field('timeline');
    const timeline = timelineFor(story, lang, sourceName);
    if (slot) {
      const view = timeline && timelineElement({ ...timeline, heading: wordsFor(lang).storySoFar }, lang);
      slot.replaceChildren(...(view ? [view] : []));
    }

    const sources = field('sources');
    if (sources) {
      sources.replaceChildren(
        ...story.sources.map((source) => {
          const li = document.createElement('li');
          const href = safeUrl(source.url);
          const el = document.createElement(href ? 'a' : 'span');
          if (el instanceof HTMLAnchorElement && href) {
            el.href = href;
            el.rel = 'noopener noreferrer';
          }
          el.textContent = sourceName(source.sourceId);
          li.append(el);
          return li;
        }),
      );
    }
    show('story');
  }

  page?.querySelector('[data-retry]')?.addEventListener('click', () => void render());
  void render();
</script>

<style>
  .page {
    max-width: 680px;
    margin: 0 auto;
    padding: 28px var(--gutter) 48px;
  }

  .state {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 32px 0;
    color: var(--ink);
    font: 400 18px / 1.5 var(--f-body);
  }

  .action {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 18px;
    border: 1.5px solid var(--line2);
    border-radius: 12px;
    background: none;
    color: var(--ink);
    font: 700 15px / 1 var(--f-body);
    text-decoration: none;
    cursor: pointer;
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    color: var(--ink);
    font: 600 15px / 1.4 var(--f-body);
  }

  .developing,
  .updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .developing :global(.icon) {
    color: var(--hot);
  }

  .updated {
    color: var(--meta);
    font-weight: 500;
  }

  h1 {
    margin-top: 14px;
    font: 800 30px / 1.12 var(--f-head);
    letter-spacing: -0.022em;
  }

  .evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-top: 16px;
    color: var(--ink);
    font: 600 15px / 1.4 var(--f-body);
  }

  h2 {
    margin-top: 36px;
    color: var(--meta);
    font: 500 15px / 1.3 var(--f-body);
    letter-spacing: 0;
  }


  .sources ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .sources :global(li) {
    border-bottom: 1px solid var(--line);
  }

  .sources :global(a),
  .sources :global(span) {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--ink);
    font: 500 16px / 1.3 var(--f-body);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    margin-top: 32px;
    color: var(--ink);
    font: 700 15px / 1 var(--f-body);
    text-decoration: none;
  }

  @media (width >= 1024px) {
    .page {
      padding-top: 48px;
    }

    h1 {
      font-size: 38px;
    }
  }
</style>
