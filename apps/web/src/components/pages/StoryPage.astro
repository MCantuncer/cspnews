---
/**
 * The story page (docs/design/system.md, "Story page"). Desktop: the fact sheet, with the key
 * numbers in their own column. Phone: the same layers, one story per screen.
 */
import { storyIn, type WrittenStory } from '@cspnews/core';

import Contents from '../contents/Contents.astro';
import EvidenceDrawer from '../evidence/EvidenceDrawer.astro';
import Header from '../Header.astro';
import HotLine from '../hot/HotLine.astro';
import Body from '../story/Body.astro';
import EvidenceLine from '../story/EvidenceLine.astro';
import Facts from '../story/Facts.astro';
import Follow from '../story/Follow.astro';
import StoryNav from '../story/StoryNav.astro';
import Summary from '../story/Summary.astro';
import TimelineView from '../story/Timeline.astro';
import VisualView from '../visual/Visual.astro';
import Base from '../../layouts/Base.astro';
import {
  bulletinPath,
  caughtUpPath,
  readKey,
  storiesIn,
  storyPath,
  type PublishedBulletin,
} from '../../lib/bulletins';
import { editionHourFor } from '../../lib/edition';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatTime } from '../../lib/format';
import { bulletinName, sectionName, storyPosition, updatedAt, wordsFor } from '../../lib/i18n';
import { outletNames, sourceName } from '../../lib/sources';
import { storyVisual } from '../../lib/story-visual';
import { timelineFor } from '../../lib/timeline';

interface Props {
  published: PublishedBulletin;
  story: WrittenStory;
  index: number;
  lang: InterfaceLanguage;
}


const { published, index, lang } = Astro.props;
const words = wordsFor(lang);
// Every story is written in both languages: the reader gets theirs.
const story = storyIn(Astro.props.story, lang);
const stories = storiesIn(published, lang);
const previous = stories[index - 1];
const next = stories[index + 1];
const timeline = timelineFor(story, lang, sourceName);
const name = bulletinName(published.slot, lang);
const visual = storyVisual(story);
const hasFacts = story.facts !== undefined && story.facts.length > 0;
---

<Base
  title={`${story.title} | CSPNews`}
  description={story.summary.what}
  hour={editionHourFor(published.slot)}
  lang={lang}
>
  <Header
    lang={lang}
    bulletinName={name}
    detail={`${sectionName(story.section, lang)}, ${storyPosition(index, stories.length, lang)}`}
    progress={stories.length > 1 ? index / (stories.length - 1) : 0}
    contentsHref={bulletinPath(published, lang)}
    contentsLabel={words.contents}
  />
  <HotLine lang={lang} />
  <div class="layout">
  <aside class="rail">
    <Contents published={published} lang={lang} currentId={story.id} compact />
  </aside>
  <main class="page" data-read-key={readKey(published, story)} data-section={story.section}>
    <article class="story">
      <div class="lead" lang={story.language}>
        <p class="section-name" lang={lang}>{sectionName(story.section, lang)}</p>
        <h1>{story.title}</h1>
        <EvidenceLine
          label={story.label}
          outlets={outletNames(story.sources)}
          developing={story.developing}
          lang={lang}
          developingWord={words.developing}
          updated={
            Date.parse(story.updatedAt) <= Date.parse(story.publishedAt)
              ? undefined
              : updatedAt(formatTime(story.updatedAt, lang), lang)
          }
          drawerId="evidence"
          openLabel={words.openEvidence}
        />
      </div>
      <div class="summary">
        <Summary summary={story.summary} words={words} lang={story.language} />
      </div>
      {
        timeline && (
          <div class="timeline">
            <TimelineView timeline={timeline} lang={lang} />
          </div>
        )
      }
      <aside class="side">
        {visual.kind !== 'none' && (
          <div class="visual">
            <VisualView visual={visual} lang={lang} storyLang={story.language} />
          </div>
        )}
        {story.facts && hasFacts && (
          <div class="facts">
            <Facts facts={story.facts} heading={words.facts} lang={story.language} />
          </div>
        )}
        <div class="follow-slot">
          <Follow story={story} href={storyPath(published, story, lang)} lang={lang} />
        </div>
      </aside>
      <div class="body">
        <Body
          body={story.body}
          heading={words.fullStory}
          lang={story.language}
          sourceName={sourceName}
          translatedLabel={words.translatedQuote}
        />
      </div>
    </article>
    <EvidenceDrawer
      id="evidence"
      label={story.label}
      sources={story.sources}
      section={story.section}
      lang={lang}
    />
    <StoryNav
      {...(previous && { previous: { href: storyPath(published, previous, lang) } })}
      {...(next && { next: { href: storyPath(published, next, lang), title: next.shortTitle } })}
      previousLabel={words.previous}
      nextLabel={words.nextStory}
      end={{ href: caughtUpPath(published, lang), label: words.finish }}
    />
  </main>
  </div>
</Base>

<script>
  import { rememberStory } from '../../lib/read';

  const key = document.querySelector('[data-read-key]')?.getAttribute('data-read-key');
  if (key) rememberStory(key);
</script>

<style>
  .rail {
    display: none;
  }

  /* Wide screens keep Contents beside the story, as a left rail. */
  @media (width >= 1280px) {
    .layout {
      display: grid;
      grid-template-columns: 300px minmax(0, 1fr);
      max-width: 1520px;
      margin: 0 auto;
    }

    .rail {
      position: sticky;
      top: 0;
      display: block;
      max-height: 100dvh;
      overflow-y: auto;
      padding: 16px 24px 32px var(--gutter);
      border-right: 1px solid var(--line);
      overscroll-behavior: contain;
    }
  }

  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px var(--gutter) 0;
  }

  /*
   * Phone order: headline, summary, visual, timeline, numbers, full story. The three summary
   * lines come straight after the headline so the first screen already tells the story
   * (US-11); how the story spread is a second question, so the timeline follows the picture.
   */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .side {
    display: contents;
  }

  .lead {
    order: 1;
  }

  .summary {
    order: 2;
  }

  .visual {
    order: 3;
    margin-top: 28px;
  }

  .timeline {
    order: 4;
  }

  .facts {
    order: 5;
  }

  .body {
    order: 6;
  }

  /* On a phone, following is offered once the story has been read. */
  .follow-slot {
    order: 7;
  }

  /* Under the headline the summary needs less air than it does under a picture. */
  .summary :global(.summary) {
    margin-top: 20px;
  }

  /* The section's name in its own hue, on a short line of the same colour. */
  .section-name {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--sec);
    font: 700 14px / 1.3 var(--f-body);
  }

  .section-name::before {
    width: 22px;
    height: 2px;
    border-radius: 1px;
    background: currentcolor;
    content: '';
  }

  h1 {
    font: 800 27px / 1.14 var(--f-head);
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  @media (width >= 1024px) {
    .page {
      padding: 48px 56px 56px;
    }

    .story {
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 64px;
      align-items: start;
    }

    .lead,
    .summary,
    .timeline,
    .body {
      grid-column: 1;
    }

    .summary :global(.summary) {
      margin-top: 28px;
    }

    .side {
      display: block;
      grid-row: 1 / span 4;
      grid-column: 2;
      padding-top: 8px;
    }

    .visual {
      margin: 0 0 28px;
    }

    .follow-slot:first-child :global(.follow) {
      margin-top: 0;
    }

    h1 {
      font-size: 40px;
      line-height: 1.1;
    }
  }
</style>
