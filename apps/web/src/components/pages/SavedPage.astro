---
/**
 * Saved stories (docs/design/decisions/saved-and-archive.md): the reading list, drawn in the
 * browser from what this browser kept, so the page itself holds nothing personal.
 */
import Header from '../Header.astro';
import Base from '../../layouts/Base.astro';
import type { InterfaceLanguage } from '../../lib/evidence';
import { sectionName } from '../../lib/i18n';
import { savedWords } from '../../lib/saved-words';

interface Props {
  lang: InterfaceLanguage;
}

const { lang } = Astro.props;
const words = savedWords(lang);
const sections = Object.fromEntries(
  (['turkey', 'tech', 'world'] as const).map((section) => [section, sectionName(section, lang)]),
);
---

<Base title={`${words.savedTitle} | CSPNews`} lang={lang} description={words.savedIntro}>
  <Header lang={lang} />
  <main class="saved" data-saved data-lang={lang} data-sections={JSON.stringify(sections)} data-remove={words.remove}>
    <h1>{words.savedTitle}</h1>
    <p class="intro">{words.savedIntro}</p>
    <ul data-saved-list></ul>
    <p class="empty" data-saved-empty>{words.savedEmpty}</p>
  </main>
</Base>

<script>
  import { showSaved } from '../../lib/saved-view';

  showSaved(document);
</script>

<style>
  .saved {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 36px var(--gutter) 64px;
  }

  h1 {
    font: 800 32px / 1.1 var(--f-head);
    letter-spacing: -0.025em;
  }

  .intro,
  .empty {
    margin-top: 10px;
    color: var(--meta);
    font: 400 17px / 1.5 var(--f-body);
  }

  ul {
    display: grid;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  ul :global(li) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  ul :global(a) {
    display: grid;
    gap: 4px;
    color: var(--ink);
    text-decoration: none;
  }

  ul :global(.section) {
    color: var(--meta);
    font: 600 14px / 1.3 var(--f-body);
  }

  ul :global(.title) {
    font: 700 20px / 1.25 var(--f-head);
    letter-spacing: -0.012em;
  }

  ul :global(a:hover .title) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  ul :global(button) {
    flex: none;
    min-height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--line2);
    border-radius: 10px;
    background: none;
    color: var(--ink);
    font: 600 14px / 1 var(--f-body);
    cursor: pointer;
  }
</style>
