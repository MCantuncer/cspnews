---
/** A whole Contents screen: the bulletin's name, its date and size, then the spine. */
import {
  briefPath,
  readingMinutes,
  storiesIn,
  storyPath,
  type PublishedBulletin,
} from '../../lib/bulletins';
import { evidenceWord, type InterfaceLanguage } from '../../lib/evidence';
import type { StoryNow } from '../../lib/follow';
import { followWords } from '../../lib/follow-words';
import { sourceName } from '../../lib/sources';
import { formatLongDate, formatTime } from '../../lib/format';
import { bulletinName, bulletinSize, wordsFor } from '../../lib/i18n';
import { GAME_PATHS, todayLine } from '../../lib/word';
import Icon from '../ui/Icon.astro';
import Contents from './Contents.astro';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const { publishAt, stories } = published.bulletin;
const words = wordsFor(lang);
// Followed stories are compared in the browser; the page carries what each story is now.
const now: StoryNow[] = storiesIn(published, lang).map((story) => ({
  id: story.id,
  title: story.shortTitle,
  href: storyPath(published, story, lang),
  section: story.section,
  label: story.label,
  labelWord: evidenceWord(story.label, lang),
  sources: story.sources.map((s) => ({ id: s.sourceId, name: sourceName(s.sourceId) })),
  updatedAt: story.updatedAt,
}));
---

<main class="screen">
  <h1>{bulletinName(published.slot, lang)}</h1>
  <p class="meta">
    {
      `${formatLongDate(publishAt, lang)}, ${formatTime(publishAt, lang)}. ${bulletinSize(stories.length, readingMinutes(published, lang), lang)}.`
    }
  </p>
  <a class="brief" href={briefPath(published, lang)}>
    <Icon name="next" size={18} />
    <span><b>{words.brief}.</b> {words.briefHint}</span>
  </a>
  <a class="brief word" href={GAME_PATHS[lang]} data-word-today={lang}>
    <Icon name="word" size={18} />
    <span><b>{words.wordToday}.</b> <span data-word-line>{todayLine({ kind: 'new' }, lang)}</span></span>
    <span class="word-marks" data-word-marks aria-hidden="true" hidden></span>
  </a>
  <section class="since" data-since={JSON.stringify(now)} data-lang={lang} hidden>
    <h2>{followWords(lang).since}</h2>
    <ul data-since-list></ul>
  </section>
  <a class="resume" href="#" data-resume hidden>
    <span class="resume-text">
      <span class="resume-label">{words.resume}</span>
      <span class="resume-title" data-resume-title></span>
    </span>
    <Icon name="next" />
  </a>
  <Contents published={published} lang={lang} />
</main>

<script>
  import { showResume } from '../../lib/read';

  import { showMoved } from '../../lib/follow-view';
  import { showWordToday } from '../../lib/word-entry';

  showResume(document);
  showWordToday(document);
  showMoved(document);
</script>

<style>
  .screen {
    max-width: 640px;
    margin: 0 auto;
    padding: 28px var(--gutter) 48px;
  }

  h1 {
    font: 800 32px / 1.08 var(--f-head);
    letter-spacing: -0.03em;
  }

  .meta {
    margin-top: 8px;
    color: var(--meta);
    font: 400 16px / 1.5 var(--f-body);
  }

  /* The short way through: the whole bulletin in one sentence a story. */
  .brief {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 10px;
    color: var(--meta);
    font: 400 16px / 1.4 var(--f-body);
    text-decoration: none;
  }

  .brief b {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* The day's word game sits right under it, so it can be played before, or instead of, reading. */
  .word {
    display: flex;
    width: fit-content;
    margin-top: 0;
  }

  .brief :global(svg) {
    flex: none;
    color: var(--hour);
  }

  /* Followed stories that moved since they were read come first, each with what changed. */
  .since {
    max-width: 560px;
    margin-top: 28px;
  }

  .since h2 {
    font: 800 22px / 1.15 var(--f-head);
    letter-spacing: -0.015em;
  }

  .since ul {
    display: grid;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .since :global(a) {
    display: grid;
    gap: 8px;
    padding: 16px 18px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--sec, var(--hour)) 8%, transparent);
    color: var(--ink);
    text-decoration: none;
  }

  .since :global(a:hover .since-title) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .since :global(.since-title) {
    font: 700 19px / 1.25 var(--f-head);
  }

  .since :global(.since-change) {
    display: flex;
    gap: 8px;
    align-items: baseline;
    color: var(--ink2);
    font: 400 15px / 1.45 var(--f-body);
  }

  .since :global(.since-change::before) {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sec, var(--hour));
    transform: translateY(-2px);
    content: '';
  }

  /* After a first guess: a badge for a finished day, then the six tries as in the game. */
  .word-marks {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-left: 4px;
  }

  .word-marks[hidden] {
    display: none;
  }

  .word-marks :global(.word-badge) {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: var(--bg);
  }

  .word-marks :global(.word-badge svg) {
    color: inherit;
  }

  .word-marks :global(.word-pips) {
    display: inline-flex;
    gap: 4px;
  }

  .word-marks :global(.word-pips i) {
    display: block;
    width: 14px;
    height: 6px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1.5px var(--line2);
  }

  .word-marks :global(.word-pips i.used) {
    background: var(--meta2);
    box-shadow: none;
  }

  /* Green when solved, red when out of tries: the mark, the badge and the tries used. */
  .word[data-state='solved'] {
    --tone: var(--conf);
  }

  .word[data-state='lost'] {
    --tone: var(--disp);
  }

  .word[data-state='solved'] > :global(svg),
  .word[data-state='lost'] > :global(svg) {
    color: var(--tone);
  }

  .word[data-state] .word-marks :global(.word-badge),
  .word[data-state='solved'] .word-marks :global(.word-pips i.used),
  .word[data-state='lost'] .word-marks :global(.word-pips i.used) {
    background: var(--tone);
  }

  /* Once the reader has started, one quiet line back to where they stopped. */
  .resume {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 560px;
    margin-top: 20px;
    padding: 12px 16px;
    border: 1.5px solid var(--line2);
    border-left: 4px solid var(--hour);
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .resume:hover {
    border-color: var(--ink);
    border-left-color: var(--hour);
  }

  .resume-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .resume-label {
    color: var(--meta);
    font: 500 14px / 1.3 var(--f-body);
  }

  .resume-title {
    overflow: hidden;
    font: 700 17px / 1.3 var(--f-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (width >= 1024px) {
    .screen {
      max-width: 760px;
      padding-top: 56px;
    }

    h1 {
      font-size: 40px;
    }
  }

  @media (width >= 1100px) {
    .screen {
      max-width: 1120px;
    }
  }

  @media (width >= 1400px) {
    .screen {
      max-width: 1600px;
      padding-right: 48px;
      padding-left: 48px;
    }
  }
</style>
