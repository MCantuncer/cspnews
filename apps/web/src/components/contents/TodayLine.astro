---
/**
 * The Today line (docs/design/decisions/today-line.md): up to five plain facts for the day,
 * from the bulletin itself: rates, gold, weather, the match. Quiet by design: small labels, one
 * strong figure each, and where and when it was read. Nothing when the bulletin carries none.
 */
import { todayIn } from '@cspnews/core';

import type { PublishedBulletin } from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatTime } from '../../lib/format';
import { wordsFor } from '../../lib/i18n';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const items = (published.bulletin.today ?? []).map((item) => todayIn(item, lang));
const title = wordsFor(lang).todayTitle;
---

{
  items.length > 0 && (
    <section class="today" aria-labelledby="today-title">
      <h2 id="today-title">{title}</h2>
      <dl>
        {items.map((item) => (
          <div class="item" data-kind={item.kind}>
            <dt>{item.label}</dt>
            <dd>
              <b>{item.value}</b>
              {item.note && <span class="note">{item.note}</span>}
              <span class="src">{`${item.source}, ${formatTime(item.asOf, lang)}`}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .today {
    margin-top: 28px;
  }

  h2 {
    color: var(--meta);
    font: 700 15px / 1.3 var(--f-body);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 20px;
    margin: 8px 0 0;
  }

  .item {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  dt {
    color: var(--meta);
    font: 600 14px / 1.3 var(--f-body);
  }

  dd {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  b {
    font: 800 24px / 1.15 var(--f-head);
    letter-spacing: -0.02em;
  }

  .note {
    color: var(--ink2);
    font: 400 15px / 1.35 var(--f-body);
  }

  .src {
    color: var(--meta);
    font: 400 13px / 1.3 var(--f-body);
  }
</style>
