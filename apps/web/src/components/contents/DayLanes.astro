---
/**
 * When each story broke (docs/design/decisions/day-lanes.md). Wide screens: one lane per section,
 * a dot per story at its first report, every title written beside its dot, up to the bulletin's
 * time. Narrow screens: the same day as a short list in time order. Every story opens.
 */
import { storiesBySection, storyPath, type PublishedBulletin } from '../../lib/bulletins';
import { brokeAt, dayLanes, dayWindow } from '../../lib/day-lanes';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatTime } from '../../lib/format';
import { bulletinName, sectionName, wordsFor } from '../../lib/i18n';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const words = wordsFor(lang);
const groups = storiesBySection(published, lang);
const time = (iso: string) => formatTime(iso, lang);
const publishAt = published.bulletin.publishAt;
const window = dayWindow(
  groups.flatMap((g) => g.stories.map(({ story }) => brokeAt(story))),
  publishAt,
  time,
);
const lanes = dayLanes(groups, window, time);
const hrefs = new Map(
  groups.flatMap((g) => g.stories.map(({ story }) => [story.id, storyPath(published, story, lang)])),
);
const inOrder = lanes
  .flatMap((lane) => lane.dots.map((dot) => ({ ...dot, section: lane.section })))
  .sort((a, b) => a.at - b.at);
const end = `${time(publishAt)} ${words.dayLanesEnd}`;
const anyDeveloping = inOrder.some((dot) => dot.developing);
---

<section class="lanes" aria-labelledby="lanes-title">
  <h2 id="lanes-title">{words.dayLanes}</h2>

  <div class="chart">
    {
      lanes.map((lane) => (
        <div class="lane" data-section={lane.section}>
          <span class="name">{sectionName(lane.section, lang)}</span>
          <div class="track" style={`--above: ${String(lane.above)}; --below: ${String(lane.below)}`}>
            {lane.dots.map((dot) => (
              <a
                href={hrefs.get(dot.id)}
                class:list={['story', dot.side, { developing: dot.developing }]}
                style={`--at: ${dot.at.toFixed(4)}; --label-at: ${dot.labelAt.toFixed(4)}; --row-index: ${String(dot.row)}`}
                aria-label={`${dot.time} ${dot.title}`}
              >
                <span class="stem" />
                <span class="mark" />
                <span class="label" aria-hidden="true">{dot.title}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
    <div class="scale" aria-hidden="true">
      <span />
      <span class="ticks">
        {window.ticks.map((tick) => <span style={`--at: ${tick.at.toFixed(4)}`}>{tick.time}</span>)}
        <span class="now">{end}</span>
      </span>
    </div>
    <span class="end-line" />
  </div>

  <ol class="list">
    {
      inOrder.map((dot) => (
        <li data-section={dot.section} class:list={{ developing: dot.developing }}>
          <a href={hrefs.get(dot.id)}>
            <span class="time">{dot.time}</span>
            <span class="mark" />
            <span class="title">{dot.title}</span>
          </a>
        </li>
      ))
    }
    <li class="list-end">
      <span class="time">{time(publishAt)}</span>
      <span class="mark" />
      <span class="title">{bulletinName(published.slot, lang)}</span>
    </li>
  </ol>

  {anyDeveloping && <p class="note">{words.dayLanesNote}</p>}
</section>

<style>
  .lanes {
    --row: 22px;

    margin-top: 28px;
  }

  h2 {
    color: var(--meta);
    font: 700 15px / 1.3 var(--f-body);
  }

  .mark {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--sec, var(--ink));
  }

  .developing .mark {
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--sec, var(--ink)) 25%, transparent);
  }

  /* Narrow screens: the day as a list, earliest first, ending at the bulletin. */
  .chart,
  .stem {
    display: none;
  }

  .list {
    position: relative;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .list::before {
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 61px;
    width: 2px;
    background: var(--line);
    content: '';
  }

  .list a,
  .list-end {
    position: relative;
    display: grid;
    grid-template-columns: 44px 12px minmax(0, 1fr);
    align-items: center;
    column-gap: 12px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  .list a:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .time {
    color: var(--meta);
    font: 500 14px / 1.3 var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font: 600 16px / 1.35 var(--f-body);
  }

  .list-end .time,
  .list-end .title {
    color: var(--hour);
    font-weight: 700;
  }

  .list-end .mark {
    background: var(--hour);
  }

  .note {
    margin-top: 6px;
    color: var(--meta2);
    font: 400 13px / 1.4 var(--f-body);
  }

  /* Wide screens: lanes, with every title written beside its dot in as many rows as needed. */
  @media (width >= 1100px) {
    .list {
      display: none;
    }

    .stem {
      display: block;
    }

    .chart {
      position: relative;
      display: block;
      margin-top: 10px;
    }

    .lane,
    .scale {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      align-items: center;
      column-gap: 16px;
    }

    .lane {
      border-top: 1px solid var(--line);
    }

    .lane:last-of-type {
      border-bottom: 1px solid var(--line);
    }

    .name {
      color: var(--sec, var(--ink));
      font: 700 14px / 1.2 var(--f-body);
    }

    .track {
      position: relative;
      height: calc((var(--above) + var(--below)) * var(--row) + 40px);
      margin: 0 8px;
    }

    .story {
      color: var(--ink2);
      text-decoration: none;
    }

    .story .mark {
      position: absolute;
      top: calc(var(--above) * var(--row) + 14px);
      left: calc(var(--at) * 100% - 6px);
    }

    .label {
      position: absolute;
      left: calc(var(--label-at) * 100%);
      font: 600 13px / 16px var(--f-body);
      white-space: nowrap;
    }

    .above .label {
      top: calc((var(--above) - var(--row-index, 0) - 1) * var(--row) + 2px);
    }

    .below .label {
      top: calc(var(--above) * var(--row) + 38px + var(--row-index, 0) * var(--row));
    }

    /* A hairline from each dot to its title, so a title a row or two out still points home. */
    .stem {
      position: absolute;
      left: calc(var(--at) * 100%);
      width: 1px;
      background: var(--line2);
    }

    .above .stem {
      top: calc((var(--above) - var(--row-index, 0) - 1) * var(--row) + 20px);
      height: calc((var(--row-index, 0) + 1) * var(--row) - 8px);
    }

    .below .stem {
      top: calc(var(--above) * var(--row) + 28px);
      height: calc(var(--row-index, 0) * var(--row) + 8px);
    }

    .story:hover .label {
      color: var(--ink);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .story:hover .mark {
      outline: 2px solid var(--ink);
      outline-offset: 3px;
    }

    .scale {
      height: 26px;
      color: var(--meta2);
      font: 500 12px / 1 var(--f-body);
    }

    .ticks {
      position: relative;
      height: 100%;
      margin: 0 8px;
    }

    .ticks > span {
      position: absolute;
      top: 8px;
      left: calc(var(--at) * 100%);
      transform: translateX(-50%);
    }

    /* The scale ends at the bulletin itself, named, so a quiet stretch before it reads as
       "nothing new broke", not as a chart cut short. */
    .ticks .now {
      right: 0;
      left: auto;
      color: var(--hour);
      font-weight: 700;
      white-space: nowrap;
      transform: none;
    }

    .end-line {
      position: absolute;
      top: 0;
      right: 8px;
      bottom: 26px;
      width: 2px;
      background: var(--hour);
    }
  }
</style>
