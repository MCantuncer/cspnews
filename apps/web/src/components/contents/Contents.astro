---
/**
 * Contents: the day line set upright (docs/design/system.md, "Contents"). Sections are
 * stations; each row is one short title with the evidence mark alone. The first story of each
 * section leads, in larger type. Stories already read fold into one line ("2 read") that opens
 * again on tap. `compact` is the desktop rail beside a story.
 */
import { nextBulletin, type Section } from '@cspnews/core';

import {
  readKey,
  storiesBySection,
  storyPath,
  type PublishedBulletin,
} from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatTime } from '../../lib/format';
import { nextBulletinAt, sectionName, wordsFor } from '../../lib/i18n';
import type { IconName } from '../../lib/icons';
import { outletLogos } from '../../lib/media';
import { storyVisual } from '../../lib/story-visual';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';
import VisualView from '../visual/Visual.astro';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
  currentId?: string;
  compact?: boolean;
}

const { published, lang, currentId, compact = false } = Astro.props;
const words = wordsFor(lang);
const SECTION_ICON: Record<Section, IconName> = { turkey: 'turkiye', tech: 'tech', world: 'world' };
const next = formatTime(nextBulletin(new Date(published.bulletin.publishAt)).publishAt.toISOString(), lang);
---

<nav class:list={['contents', { compact }]} aria-label={words.contents} data-contents data-lang={lang}>
  <ol class="spine">
    {
      storiesBySection(published).map((group) => (
        <li class="section">
          <h2 class="station">
            <Icon name={SECTION_ICON[group.section]} size={22} class="section-icon" />
            {sectionName(group.section, lang)}
          </h2>
          <ol class="stories">
            <li class="fold" hidden>
              <button type="button" aria-expanded="false">
                <Icon name="tick" size={18} />
                <span class="fold-count" />
                <Icon name="more" size={18} class="fold-chevron" />
              </button>
            </li>
            {group.stories.map(({ story }, i) => {
              const current = story.id === currentId;
              const lead = i === 0 && !compact;
              const visual = compact ? undefined : storyVisual(story);
              const logos = compact ? [] : outletLogos(story.sources);
              const [firstLogo] = logos;
              // Only a photo earns the full width; charts, maps and logos stay small.
              const wide = lead && visual?.kind === 'photo';
              return (
                <li
                  class:list={['row', { lead, wide, current }]}
                  data-read-key={readKey(published, story)}
                >
                  <a
                    href={storyPath(published, story)}
                    aria-current={current ? 'page' : undefined}
                    lang={story.language}
                  >
                    {wide && visual && (
                      <span class="pic">
                        <VisualView visual={visual} lang={lang} storyLang={story.language} size="wide" />
                      </span>
                    )}
                    {!wide && !compact && visual && visual.kind !== 'none' && (
                      <span class="thumb" aria-hidden="true">
                        <VisualView visual={visual} lang={lang} storyLang={story.language} size="thumb" />
                      </span>
                    )}
                    {!compact && visual?.kind === 'none' && firstLogo && (
                      <span class="thumb logo-thumb" aria-hidden="true">
                        <img src={firstLogo.src} alt="" loading="lazy" decoding="async" />
                      </span>
                    )}
                    <span class="text">
                      <span class="title">{story.shortTitle}</span>
                      {lead && <span class="gist">{story.summary.what}</span>}
                      {!compact && (
                        <span class="meta">
                          <EvidenceMark label={story.label} lang={lang} variant="glyph" />
                          {logos.length > 0 && (
                            <span class="outlets">
                              {logos.map((logo) => (
                                <img src={logo.src} alt={logo.name} title={logo.name} loading="lazy" decoding="async" />
                              ))}
                            </span>
                          )}
                        </span>
                      )}
                    </span>
                    {compact && <EvidenceMark label={story.label} lang={lang} variant="glyph" />}
                  </a>
                </li>
              );
            })}
          </ol>
        </li>
      ))
    }
    <li class="end">
      <b>{words.endOfBulletin}.</b>{' '}{nextBulletinAt(next, lang)}
    </li>
  </ol>
</nav>

<script>
  import { foldReadStories } from '../../lib/read';

  foldReadStories(document);
</script>

<style>
  .spine,
  .stories {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The upright day line. */
  .spine {
    position: relative;
    padding-left: 40px;
  }

  .spine::before {
    position: absolute;
    top: 40px;
    bottom: 34px;
    left: 13px;
    width: 2px;
    background: var(--line2);
    content: '';
  }

  .section,
  .row,
  .fold,
  .end {
    position: relative;
  }

  .station {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 30px 0 4px;
    font: 800 24px / 1.15 var(--f-head);
    letter-spacing: -0.02em;
  }

  .section:first-child .station {
    padding-top: 20px;
  }

  /* Each section is a station on the line. */
  .station::before {
    position: absolute;
    left: -34px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg);
    content: '';
  }

  .station :global(.section-icon) {
    color: var(--meta);
  }

  .row a {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 10px 0;
    color: var(--ink);
    text-decoration: none;
  }

  .row a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .text {
    display: grid;
    flex: 1;
    gap: 6px;
    min-width: 0;
  }

  .title {
    font: 600 17px / 1.3 var(--f-body);
  }

  .thumb {
    display: grid;
    flex: none;
    place-items: center;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surf);
  }

  .thumb :global(.visual.thumb),
  .thumb :global(.visual.thumb img),
  .thumb :global(.visual.thumb svg) {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  /* Logos are drawn for white, so they sit on white in both themes. */
  .logo-thumb {
    background: #fff;
  }

  .logo-thumb img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .outlets {
    display: flex;
  }

  .outlets img {
    width: 22px;
    height: 22px;
    margin-left: -5px;
    border: 2px solid var(--bg);
    border-radius: 50%;
    background: #fff;
    object-fit: contain;
  }

  .outlets img:first-child {
    margin-left: 0;
  }

  /* A section's lead: a larger title and the gist; a photo runs across the column above. */
  .lead a {
    padding: 14px 0 12px;
  }

  .wide a {
    display: grid;
    gap: 14px;
  }

  .pic :global(.visual) {
    overflow: hidden;
    border-radius: 10px;
  }

  .pic :global(img),
  .pic :global(svg) {
    border-radius: 10px;
  }

  .lead .title {
    font: 800 24px / 1.15 var(--f-head);
    letter-spacing: -0.018em;
  }

  .gist {
    display: -webkit-box;
    overflow: hidden;
    color: var(--meta);
    font: 400 16px / 1.45 var(--f-body);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* A short branch from the line to each row. */
  .row::before,
  .fold::before {
    position: absolute;
    top: 50%;
    left: -27px;
    width: 12px;
    height: 2px;
    background: var(--line2);
    content: '';
  }

  .wide::before {
    top: 34px;
  }

  .current::before {
    display: none;
  }

  .current::after {
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: -29px;
    width: 6px;
    border-radius: 1px;
    background: var(--hour);
    content: '';
  }

  .fold button {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--meta);
    font: 600 15px / 1 var(--f-body);
    cursor: pointer;
  }

  .fold :global(.fold-chevron) {
    transform: rotate(90deg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .fold button[aria-expanded='true'] :global(.fold-chevron) {
    transform: rotate(-90deg);
  }

  .end {
    padding: 26px 0 8px;
    color: var(--meta);
    font: 500 16px / 1.4 var(--f-body);
  }

  .end b {
    color: var(--ink);
    font-weight: 700;
  }

  .end::before {
    position: absolute;
    top: 29px;
    left: -33px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--line2);
    border-radius: 50%;
    background: var(--bg);
    content: '';
  }

  /* The rail beside a story on wide screens. */
  .compact .station {
    padding-top: 26px;
    font-size: 19px;
  }

  .compact .row a {
    min-height: 48px;
    padding: 6px 0;
  }

  .compact .title {
    overflow: hidden;
    font-size: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .compact .lead .title {
    font: 800 18px / 1.2 var(--f-head);
    white-space: normal;
  }

  @media (width >= 1024px) {
    .contents:not(.compact) .title {
      font-size: 19px;
    }

    .contents:not(.compact) .lead .title {
      font-size: 30px;
    }

    .contents:not(.compact) .gist {
      font-size: 17px;
    }

    .contents:not(.compact) .thumb {
      width: 76px;
      height: 76px;
    }

    .contents:not(.compact) .station {
      font-size: 28px;
    }
  }

  /* Wide screens: each section reads like a front page, the lead on the left and the rest
     stacked beside it, so the screen is used without stretching any line. */
  @media (width >= 1100px) {
    .contents:not(.compact) .stories {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      column-gap: 40px;
      align-items: start;
    }

    .contents:not(.compact) .stories > li {
      grid-column: 2;
    }

    .contents:not(.compact) .stories > .lead {
      grid-row: 1 / span 12;
      grid-column: 1;
    }

    .contents:not(.compact) .stories > li:not(.lead)::before {
      display: none;
    }
  }

  .compact .end {
    font-size: 15px;
  }
</style>
