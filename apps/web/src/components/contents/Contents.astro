---
/**
 * Contents: the day line set upright (docs/design/system.md, "Contents"). Sections are
 * stations; each row is one short title with the evidence mark alone. The first story of each
 * section leads, in larger type. Stories already read fold into one line ("2 read") that opens
 * again on tap. `compact` is the desktop rail beside a story.
 */
import { nextBulletin, type Section } from '@cspnews/core';

import {
  readKey,
  storiesBySection,
  storyPath,
  type PublishedBulletin,
} from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import { formatTime } from '../../lib/format';
import { nextBulletinAt, sectionName, wordsFor } from '../../lib/i18n';
import type { IconName } from '../../lib/icons';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
  currentId?: string;
  compact?: boolean;
}

const { published, lang, currentId, compact = false } = Astro.props;
const words = wordsFor(lang);
const SECTION_ICON: Record<Section, IconName> = { turkey: 'turkiye', tech: 'tech', world: 'world' };
const next = formatTime(nextBulletin(new Date(published.bulletin.publishAt)).publishAt.toISOString(), lang);
---

<nav class:list={['contents', { compact }]} aria-label={words.contents} data-contents data-lang={lang}>
  <ol class="spine">
    {
      storiesBySection(published).map((group) => (
        <li class="section">
          <h2 class="station">
            <Icon name={SECTION_ICON[group.section]} size={22} class="section-icon" />
            {sectionName(group.section, lang)}
          </h2>
          <ol class="stories">
            <li class="fold" hidden>
              <button type="button" aria-expanded="false">
                <Icon name="tick" size={18} />
                <span class="fold-count" />
                <Icon name="more" size={18} class="fold-chevron" />
              </button>
            </li>
            {group.stories.map(({ story }, i) => {
              const current = story.id === currentId;
              return (
                <li
                  class:list={['row', { lead: i === 0, current }]}
                  data-read-key={readKey(published, story)}
                >
                  <a
                    href={storyPath(published, story)}
                    aria-current={current ? 'page' : undefined}
                    lang={story.language}
                  >
                    <span class="title">{story.shortTitle}</span>
                    <EvidenceMark label={story.label} lang={lang} variant="glyph" />
                  </a>
                </li>
              );
            })}
          </ol>
        </li>
      ))
    }
    <li class="end">
      <b>{words.endOfBulletin}.</b>{' '}{nextBulletinAt(next, lang)}
    </li>
  </ol>
</nav>

<script>
  import { foldReadStories } from '../../lib/read';

  foldReadStories(document);
</script>

<style>
  .spine,
  .stories {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The upright day line. */
  .spine {
    position: relative;
    padding-left: 40px;
  }

  .spine::before {
    position: absolute;
    top: 40px;
    bottom: 34px;
    left: 13px;
    width: 2px;
    background: var(--line2);
    content: '';
  }

  .section,
  .row,
  .fold,
  .end {
    position: relative;
  }

  .station {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 30px 0 4px;
    font: 800 24px / 1.15 var(--f-head);
    letter-spacing: -0.02em;
  }

  .section:first-child .station {
    padding-top: 20px;
  }

  /* Each section is a station on the line. */
  .station::before {
    position: absolute;
    left: -34px;
    width: 16px;
    height: 16px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg);
    content: '';
  }

  .station :global(.section-icon) {
    color: var(--meta);
  }

  .row a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 6px 0;
    color: var(--ink);
    font: 500 17px / 1.3 var(--f-body);
    text-decoration: none;
  }

  .row a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lead a {
    min-height: 72px;
    padding: 12px 0;
  }

  .lead .title {
    font: 800 21px / 1.18 var(--f-head);
    letter-spacing: -0.015em;
    white-space: normal;
  }

  /* A short branch from the line to each row. */
  .row::before,
  .fold::before {
    position: absolute;
    top: 50%;
    left: -27px;
    width: 12px;
    height: 2px;
    background: var(--line2);
    content: '';
  }

  .current::before {
    display: none;
  }

  .current::after {
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: -29px;
    width: 6px;
    border-radius: 1px;
    background: var(--hour);
    content: '';
  }

  .fold button {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--meta);
    font: 600 15px / 1 var(--f-body);
    cursor: pointer;
  }

  .fold :global(.fold-chevron) {
    transform: rotate(90deg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .fold button[aria-expanded='true'] :global(.fold-chevron) {
    transform: rotate(-90deg);
  }

  .end {
    padding: 26px 0 8px;
    color: var(--meta);
    font: 500 16px / 1.4 var(--f-body);
  }

  .end b {
    color: var(--ink);
    font-weight: 700;
  }

  .end::before {
    position: absolute;
    top: 29px;
    left: -33px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--line2);
    border-radius: 50%;
    background: var(--bg);
    content: '';
  }

  /* The rail beside a story on wide screens. */
  .compact .station {
    padding-top: 26px;
    font-size: 19px;
  }

  .compact .row a {
    min-height: 48px;
    font-size: 16px;
  }

  .compact .lead .title {
    font-size: 18px;
  }

  .compact .end {
    font-size: 15px;
  }
</style>
