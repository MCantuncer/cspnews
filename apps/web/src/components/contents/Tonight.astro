---
/**
 * Tonight (docs/design/decisions/tonight.md): the matches and shows Turkish readers follow,
 * from the bulletin's `tonight` list. Each row: a station that fills as it goes (hollow, ringed,
 * filled), the name, what it is with small team logos, and on the right the time or the score.
 * Nothing when the bulletin carries no rows.
 */
import { sortTonight, tonightIn, type TonightSide } from '@cspnews/core';

import type { PublishedBulletin } from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import { playerPhotoUrl, teamLogoUrl } from '../../lib/media';
import Icon from '../ui/Icon.astro';
import {
  isBoard,
  orderScorers,
  personMarks,
  tonightOutcome,
  tonightStatus,
  tonightWhat,
  tonightWords,
} from '../../lib/tonight';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const words = tonightWords(lang);
const builtAt = new Date(published.bulletin.publishAt);
const rows = sortTonight(published.bulletin.tonight ?? []).map((item) => {
  const local = tonightIn(item, lang);
  const board = isBoard(item);
  return {
    local,
    board,
    scorers: orderScorers(item.scorers ?? []).map((scorer) => ({
      ...scorer,
      src: scorer.photo ? playerPhotoUrl(scorer.photo) : undefined,
    })),
    status: tonightStatus(item, lang, builtAt, board),
    outcome: tonightOutcome(item),
    marks: (item.lines ?? []).map((line) => ({
      line,
      marks: personMarks(line),
      label: personMarks(line)
        .map((mark) => words[mark.kind](mark.count))
        .join(', '),
    })),
    data: JSON.stringify({
      kind: item.kind,
      sport: item.sport,
      startsAt: item.startsAt,
      result: item.result,
      board,
    }),
  };
});
const logo = (side: TonightSide | undefined) => (side?.team ? teamLogoUrl(side.team) : undefined);
---

{
  rows.length > 0 && (
    <section class="tonight" aria-labelledby="tonight-title">
      <h2 id="tonight-title">{words.title}</h2>
      <ul>
        {rows.map(({ local, board, scorers, status, data, outcome, marks }) => (
          <li
            class:list={{ board }}
            data-tonight-row={data}
            data-lang={lang}
            data-state={status.state}
            data-outcome={outcome}
            data-live-source={local.live?.source}
            data-live-ref={local.live?.ref}
            data-sport={local.sport}
            data-ours={
              local.home?.ours && !local.away?.ours
                ? 'home'
                : local.away?.ours && !local.home?.ours
                  ? 'away'
                  : undefined
            }
            data-final={local.result ? 'true' : undefined}
          >
            <span class="station" aria-hidden="true" />
            <div class="body">
              {board && local.home && local.away ? (
                <>
                  {local.focus === 'person' && (
                    <div class="person">
                      <span class="name">{local.name}</span>
                      <span class="marks-line" data-marks>
                        {marks.map(
                          (person) =>
                            person.marks.length > 0 && (
                              <span class="marks" role="img" aria-label={person.label}>
                                {person.marks.map((mark) => (
                                  <span class="mark">
                                    <span class="count">{mark.count}</span>
                                    <span class="word">
                                      {words.unit(mark.kind, mark.count, local.sport)}
                                    </span>
                                  </span>
                                ))}
                              </span>
                            ),
                        )}
                      </span>
                    </div>
                  )}
                  <button
                    type="button"
                    class="match"
                    aria-expanded="false"
                    aria-label={words.details}
                    data-match-toggle
                  >
                    {(['home', 'away'] as const).map((key) => {
                      const side = local[key];
                      return (
                        side && (
                          <div class:list={['team', key, { ours: side.ours }]}>
                            {!logo(local.home) && !logo(local.away) ? undefined : logo(side) ? (
                              local.focus === 'national' ? (
                                <span class="flag">
                                  <img src={logo(side)} alt="" width="30" height="30" />
                                </span>
                              ) : (
                                <img class="logo" src={logo(side)} alt="" width="24" height="24" />
                              )
                            ) : (
                              <span class="crest" aria-hidden="true" />
                            )}
                            <span class="team-name">
                              {side.short ? (
                                <>
                                  <span class="full">{side.name}</span>
                                  <span class="short">{side.short}</span>
                                </>
                              ) : (
                                side.name
                              )}
                            </span>
                          </div>
                        )
                      );
                    })}
                    <div class="middle">
                      <span class="scoreline">
                        <b class="score home" data-score="home">
                          {local.result?.home}
                        </b>
                        <span class="dash" aria-hidden="true">
                          –
                        </span>
                        <b class="score away" data-score="away">
                          {local.result?.away}
                        </b>
                      </span>
                      <b class="clock" data-figure>
                        {status.figure}
                      </b>
                      {outcome && (
                        <span class="visually-hidden">
                          {outcome === 'win' ? words.won : outcome === 'loss' ? words.lost : words.drew}
                        </span>
                      )}
                      <span class="status">
                        <small data-word>{status.word}</small>
                        <span class="chevron" aria-hidden="true">
                          <Icon name="more" size={14} />
                        </span>
                      </span>
                    </div>
                  </button>
                  <ul class="scorers" aria-label={words.scored} data-scorers>
                    {scorers.map((scorer) => (
                      <li
                        class:list={[scorer.side, { ours: local[scorer.side]?.ours, own: scorer.own }]}
                        data-name={scorer.name}
                      >
                        <span class="minutes">
                          {scorer.minutes ? scorer.minutes.join(' ') : scorer.points}
                          {!scorer.minutes && (
                            <span class="unit">
                              {' '}
                              {words.unit('points', scorer.points ?? 0, local.sport).toLocaleUpperCase(lang)}
                            </span>
                          )}
                        </span>
                        <span class="who">
                          {scorer.src && (
                            <img class="photo" src={scorer.src} alt="" width="24" height="24" />
                          )}
                          {scorer.name}
                          {scorer.penalty && <span class="unit"> {words.penalty.toLocaleUpperCase(lang)}</span>}
                          {scorer.own && <span class="unit"> {words.ownGoal.toLocaleUpperCase(lang)}</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <>
                  <span class="name">{local.name}</span>
                  <span class="what">{tonightWhat(local, lang)}</span>
                </>
              )}
              <span class="comp">{local.competition}</span>
            </div>
            {!board && (
            <div class="when">
              <b data-figure>{status.figure}</b>
              {outcome && (
                <span class="visually-hidden">
                  {outcome === 'win' ? words.won : outcome === 'loss' ? words.lost : words.drew}
                </span>
              )}
              <small data-word>{status.word}</small>
            </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  import { followScores } from '../../lib/live';
  import { showTonight } from '../../lib/tonight-view';

  showTonight(document);
  // A match opens to show who scored, and closes again.
  for (const toggle of document.querySelectorAll<HTMLElement>('[data-match-toggle]')) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
  followScores(document);
</script>

<style>
  .tonight {
    max-width: 640px;
    margin-top: 28px;
  }

  h2 {
    color: var(--meta);
    font: 700 15px / 1.3 var(--f-body);
  }

  ul {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: start;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  /* A small station on the day line: hollow before, ringed while on, filled once over. */
  .station {
    width: 12px;
    height: 12px;
    margin-top: 6px;
    border: 2px solid var(--line2);
    border-radius: 50%;
  }

  [data-state='on'] .station {
    border-color: var(--hot);
    box-shadow: inset 0 0 0 2px var(--bg);
    background: var(--hot);
  }

  [data-state='over'] .station {
    border-color: var(--ink);
    background: var(--ink);
  }

  .body {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  /* The name and a person's numbers share one line, and wrap from the left edge together. */
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    color: var(--ink);
    font: 700 18px / 1.25 var(--f-head);
    letter-spacing: -0.01em;
  }

  .what {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 6px;
    color: var(--ink2);
    font: 400 15px / 1.4 var(--f-body);
  }

  .side {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .side.ours {
    color: var(--ink);
    font-weight: 600;
  }

  /* A club or national team row is the fixture itself, set as the row's name. */
  .what.fixture {
    color: var(--ink2);
    font: 500 18px / 1.25 var(--f-head);
  }

  .what.fixture .ours {
    font-weight: 700;
  }

  .what.fixture img {
    width: 20px;
    height: 20px;
  }

  .side img {
    flex: none;
    object-fit: contain;
  }

  .vs,
  .comp {
    color: var(--meta);
  }

  .comp {
    font: 400 14px / 1.35 var(--f-body);
  }

  .when {
    display: grid;
    justify-items: end;
    gap: 6px;
    text-align: right;
    white-space: nowrap;
  }

  .when b {
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .when small {
    color: var(--meta);
    font: 500 13px / 1.3 var(--f-body);
  }

  /* The result for our side, said softly: the filled station takes the colour, the score a tint. */
  [data-outcome='win'] .station {
    border-color: var(--conf);
    background: var(--conf);
  }

  [data-outcome='loss'] .station {
    border-color: var(--disp);
    background: var(--disp);
  }

  [data-outcome='win'] .when b {
    color: color-mix(in srgb, var(--conf) 55%, var(--ink));
  }

  [data-outcome='loss'] .when b {
    color: color-mix(in srgb, var(--disp) 55%, var(--ink));
  }

  /*
   * A person's row: their name, then their own numbers as a small box score on a line of its
   * own (each number over its word), then the match as a scoreline like every other match.
   */
  .person {
    display: grid;
    gap: 4px;
    margin-bottom: 14px;
  }

  .marks-line:empty {
    display: none;
  }

  .marks-line,
  .marks {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }

  .mark {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .mark .count {
    color: var(--ink);
    font: 600 15px / 1.3 var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  .mark .word {
    color: var(--meta);
    font: 400 14px / 1.3 var(--f-body);
  }

  .unit {
    color: var(--meta);
    font: 600 11px / 1 var(--f-body);
    letter-spacing: 0.08em;
  }

  [data-state='on'] .when small {
    color: var(--hot);
  }

  /*
   * A club or national team match is drawn as a scoreline: the home team on the left, the score
   * and the clock in the middle, the away team on the right, and each goal under the side that
   * scored it, minute first.
   */
  li.board {
    grid-template-columns: 16px minmax(0, 1fr);
  }

  .match {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  /* The scoreline is a button: closed it is the score alone, open it adds who scored. */
  button.match {
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  button.match:focus-visible {
    border-radius: 6px;
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .chevron {
    display: inline-flex;
    color: var(--meta);
    transform: rotate(90deg);
    transition: transform 0.2s ease;
  }

  [aria-expanded='true'] .chevron {
    transform: rotate(-90deg);
  }

  /* Nothing to open before a goal or a basket. */
  .board:has(.scorers:empty) .chevron {
    display: none;
  }

  .board:has([aria-expanded='false']) .scorers {
    display: none;
  }

  /* Each team on the score's line: its crest next to the score, its name outside it. */
  .team {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--ink2);
    font: 500 15px / 1.25 var(--f-head);
    overflow-wrap: break-word;
  }

  .team.home {
    flex-direction: row-reverse;
    text-align: right;
  }

  .team > :not(.team-name) {
    flex: none;
  }

  /* On a phone a long club name gives way to the source's short one: "76ers", "Rockets". */
  .team-name .short {
    display: none;
  }

  @media (max-width: 560px) {
    .team-name .full {
      display: none;
    }

    .team-name .short {
      display: inline;
    }
  }

  .team.home {
    grid-column: 1;
    grid-row: 1;
  }

  .team.away {
    grid-column: 3;
    grid-row: 1;
  }

  .team.ours {
    color: var(--ink);
    font-weight: 700;
  }

  .logo,
  .crest {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  /* No logo saved: the space stays, so the names still line up. */
  .crest {
    visibility: hidden;
  }

  /* A national team's flag, whole, as a small rounded rectangle. The saved flags sit on a square
     with clear space around them, so the picture is a little larger than its frame. */
  .flag {
    position: relative;
    display: block;
    overflow: hidden;
    width: 27px;
    height: 18px;
    border-radius: 3px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .flag img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    max-width: none;
    height: 30px;
    transform: translate(-50%, -50%);
  }

  .middle {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    justify-items: center;
    gap: 4px;
    padding-top: 2px;
    white-space: nowrap;
  }

  .scoreline {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--ink);
    font: 800 22px / 1 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .dash {
    color: var(--meta);
    font-weight: 500;
  }

  [data-ours='home'][data-outcome='win'] .score.home,
  [data-ours='away'][data-outcome='win'] .score.away {
    color: color-mix(in srgb, var(--conf) 55%, var(--ink));
  }

  [data-ours='home'][data-outcome='loss'] .score.home,
  [data-ours='away'][data-outcome='loss'] .score.away {
    color: color-mix(in srgb, var(--disp) 55%, var(--ink));
  }

  /* Before kick-off the middle is the time; then the score, with the minute or the end below. */
  .board[data-state='upcoming'] .scoreline {
    display: none;
  }

  /* Live but no score read yet: just the word, no lone dash. */
  .scoreline:has(.score.home:empty):has(.score.away:empty) {
    display: none;
  }

  .clock {
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .board[data-state='on'] .middle small {
    color: var(--hot);
    font-weight: 600;
  }

  .board:not([data-state='upcoming']) .clock {
    display: none;
  }

  .middle small {
    color: var(--meta);
    font: 500 13px / 1.3 var(--f-body);
  }

  .scorers:empty {
    display: none;
  }

  /*
   * The goals use the row's whole width: the home side's in the left half, the away side's in
   * the right half, each line the minute and then the scorer, a long name wrapping under itself.
   */
  .scorers {
    display: grid;
    grid-auto-flow: row dense;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 12px;
    margin: 14px 0 4px;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
  }

  .scorers li {
    display: grid;
    grid-template-columns: minmax(1.9em, max-content) minmax(0, 1fr);
    column-gap: 6px;
    align-items: baseline;
    padding: 0;
    border: 0;
    color: var(--ink2);
    font: 500 12px / 1.3 var(--f-body);
  }

  .scorers li.home {
    grid-column: 1;
  }

  .scorers li.away {
    grid-column: 2;
  }

  .scorers li.ours {
    color: var(--ink);
    font-weight: 600;
  }

  /* An own goal is said in a soft red, whoever it counts for. */
  .scorers li.own,
  .scorers li.own .minutes,
  .scorers li.own .unit {
    color: color-mix(in srgb, var(--disp) 75%, var(--ink));
  }

  .who .unit {
    font-size: 10px;
  }

  .photo {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin: -3px 6px 0 0;
    border-radius: 50%;
    background: var(--line);
    object-fit: cover;
    object-position: top;
    vertical-align: middle;
  }

  .minutes {
    color: var(--meta);
    font: 500 12px / 1.3 var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  .board .comp {
    margin-top: 10px;
  }
</style>
