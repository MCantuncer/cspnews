---
/**
 * Tonight (docs/design/decisions/tonight.md): the matches and shows Turkish readers follow,
 * from the bulletin's `tonight` list, as one card each. The Contents spine draws the station and
 * its title at the bottom of the bulletin; this draws the cards. Nothing when there are no rows.
 */
import { sortTonight, tonightIn, type TonightSide } from '@cspnews/core';

import type { PublishedBulletin } from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import { playerPhotoUrl, teamLogoUrl } from '../../lib/media';
import Icon from '../ui/Icon.astro';
import {
  isBoard,
  orderScorers,
  personMarks,
  tonightOutcome,
  tonightStatus,
  tonightWhat,
  tonightWords,
} from '../../lib/tonight';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const words = tonightWords(lang);
const builtAt = new Date(published.bulletin.publishAt);
const rows = sortTonight(published.bulletin.tonight ?? []).map((item) => {
  const local = tonightIn(item, lang);
  const board = isBoard(item);
  return {
    local,
    board,
    scorers: orderScorers(item.scorers ?? []).map((scorer) => ({
      ...scorer,
      src: scorer.photo ? playerPhotoUrl(scorer.photo) : undefined,
    })),
    status: tonightStatus(item, lang, builtAt, board),
    outcome: tonightOutcome(item),
    marks: (item.lines ?? []).map((line) => ({
      line,
      marks: personMarks(line),
      label: personMarks(line)
        .map((mark) => words[mark.kind](mark.count))
        .join(', '),
    })),
    data: JSON.stringify({
      kind: item.kind,
      sport: item.sport,
      startsAt: item.startsAt,
      result: item.result,
      board,
    }),
  };
});
const logo = (side: TonightSide | undefined) => (side?.team ? teamLogoUrl(side.team) : undefined);
---

{
  rows.length > 0 && (
    <ul class="cards">
      {rows.map(({ local, board, scorers, status, data, outcome, marks }) => (
        <li
          class:list={['card', { board }]}
          data-tonight-row={data}
          data-lang={lang}
          data-state={status.state}
          data-outcome={outcome}
          data-live-source={local.live?.source}
          data-live-ref={local.live?.ref}
          data-sport={local.sport}
          data-ours={
            local.home?.ours && !local.away?.ours
              ? 'home'
              : local.away?.ours && !local.home?.ours
                ? 'away'
                : undefined
          }
          data-final={local.result ? 'true' : undefined}
        >
          {board && local.home && local.away ? (
            <>
              {local.focus === 'person' ? (
                <div class="head">
                  <span class="name">{local.name}</span>
                  <span class="comp">{local.competition}</span>
                </div>
              ) : (
                <div class="head">
                  <span class="comp">{local.competition}</span>
                </div>
              )}
              {local.focus === 'person' && (
                <span class="marks-line" data-marks>
                  {marks.map(
                    (person) =>
                      person.marks.length > 0 && (
                        <span class="marks" role="img" aria-label={person.label}>
                          {person.marks.map((mark) => (
                            <span class="mark">
                              <span class="count">{mark.count}</span>
                              <span class="word">{words.unit(mark.kind, mark.count, local.sport)}</span>
                            </span>
                          ))}
                        </span>
                      ),
                  )}
                </span>
              )}
              <button
                type="button"
                class="match"
                aria-expanded="false"
                aria-label={words.details}
                data-match-toggle
              >
                {(['home', 'away'] as const).map((key) => {
                  const side = local[key];
                  return (
                    side && (
                      <div class:list={['team', key, { ours: side.ours }]}>
                        {!logo(local.home) && !logo(local.away) ? undefined : logo(side) ? (
                          local.focus === 'national' ? (
                            <span class="flag">
                              <img src={logo(side)} alt="" width="30" height="30" />
                            </span>
                          ) : (
                            <img class="logo" src={logo(side)} alt="" width="26" height="26" />
                          )
                        ) : (
                          <span class="crest" aria-hidden="true" />
                        )}
                        <span class="team-name">
                          {side.short ? (
                            <>
                              <span class="full">{side.name}</span>
                              <span class="short" aria-hidden="true">
                                {side.short}
                              </span>
                            </>
                          ) : (
                            side.name
                          )}
                        </span>
                      </div>
                    )
                  );
                })}
                <div class="middle">
                  <span class="scoreline">
                    <b class="score home" data-score="home">
                      {local.result?.home}
                    </b>
                    <span class="dash" aria-hidden="true">
                      –
                    </span>
                    <b class="score away" data-score="away">
                      {local.result?.away}
                    </b>
                  </span>
                  <b class="clock" data-figure>
                    {status.figure}
                  </b>
                  {outcome && (
                    <span class="visually-hidden">
                      {outcome === 'win' ? words.won : outcome === 'loss' ? words.lost : words.drew}
                    </span>
                  )}
                  <span class="status">
                    <small data-word>{status.word}</small>
                    <span class="chevron" aria-hidden="true">
                      <Icon name="more" size={14} />
                    </span>
                  </span>
                </div>
              </button>
              <ul class="scorers" aria-label={words.scored} data-scorers>
                {scorers.map((scorer) => (
                  <li
                    class:list={[scorer.side, { ours: local[scorer.side]?.ours, own: scorer.own }]}
                    data-name={scorer.name}
                  >
                    <span class="minutes">
                      {scorer.minutes ? scorer.minutes.join(' ') : scorer.points}
                      {!scorer.minutes && (
                        <span class="unit">
                          {' '}
                          {words.unit('points', scorer.points ?? 0, local.sport).toLocaleUpperCase(lang)}
                        </span>
                      )}
                    </span>
                    <span class="who">
                      {scorer.src && <img class="photo" src={scorer.src} alt="" width="24" height="24" />}
                      {scorer.name}
                      {scorer.penalty && <span class="unit"> {words.penalty.toLocaleUpperCase(lang)}</span>}
                      {scorer.own && <span class="unit"> {words.ownGoal.toLocaleUpperCase(lang)}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <div class="show">
              <div class="info">
                <span class="name">{local.name}</span>
                <span class="what">{tonightWhat(local, lang)}</span>
                <span class="comp">{local.competition}</span>
              </div>
              <div class="when">
                <b data-figure>{status.figure}</b>
                {outcome && (
                  <span class="visually-hidden">
                    {outcome === 'win' ? words.won : outcome === 'loss' ? words.lost : words.drew}
                  </span>
                )}
                <small data-word>{status.word}</small>
              </div>
            </div>
          )}
        </li>
      ))}
    </ul>
  )
}

<script>
  import { followScores } from '../../lib/live';
  import { showTonight } from '../../lib/tonight-view';

  showTonight(document);
  // A match opens to show who scored, and closes again.
  for (const toggle of document.querySelectorAll<HTMLElement>('[data-match-toggle]')) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
  followScores(document);
</script>

<style>
  /*
   * One quiet card a match, like the Turks abroad cards above it: who or what it is on top,
   * then the scoreline across the card. No stations, no dots: the score carries the result.
   */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 12px 0 0;
    list-style: none;
  }

  .card {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surf);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .name {
    color: var(--ink);
    font: 700 18px / 1.25 var(--f-head);
    letter-spacing: -0.01em;
  }

  .comp {
    color: var(--meta);
    font: 500 14px / 1.35 var(--f-body);
  }

  /* A club or national team card names only the competition: the teams are in the scoreline. */
  .head:not(:has(.name)) .comp {
    color: var(--ink2);
    font-weight: 600;
  }

  /* A person's own numbers on one quiet line: the number in ink, its word beside it. */
  .marks-line {
    margin-top: -8px;
  }

  .marks-line:empty {
    display: none;
  }

  .marks-line,
  .marks {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 16px;
  }

  .mark {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }

  .mark .count {
    color: var(--ink);
    font: 600 15px / 1.3 var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  .mark .word {
    color: var(--meta);
    font: 400 14px / 1.3 var(--f-body);
  }

  .unit {
    color: var(--meta);
    font: 600 11px / 1 var(--f-body);
    letter-spacing: 0.08em;
  }

  /*
   * The match under a hairline, as the scoreboard sports apps use: one line a team, crest and
   * name on the left, its score on the right, and the clock or the end beside both. Home first,
   * away second. It is a button: closed it is the score alone, open it adds who scored.
   */
  button.match {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 10px 16px;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 14px 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    cursor: pointer;
  }

  button.match:focus-visible {
    border-radius: 6px;
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .team {
    display: flex;
    grid-column: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--ink2);
    font: 500 16px / 1.25 var(--f-head);
    overflow-wrap: break-word;
  }

  .team.home {
    grid-row: 1;
  }

  .team.away {
    grid-row: 2;
  }

  .team > :not(.team-name) {
    flex: none;
  }

  .team.ours {
    color: var(--ink);
    font-weight: 700;
  }

  /* A long club name gives way to the source's short one ("76ers", "Rockets"); the full name
     stays for screen readers. */
  .team-name .full {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .logo,
  .crest {
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  /* No logo saved: the space stays, so the names still line up. */
  .crest {
    visibility: hidden;
  }

  /* A national team's flag, whole, as a small rounded rectangle. */
  .flag {
    position: relative;
    display: block;
    overflow: hidden;
    width: 27px;
    height: 18px;
    border-radius: 3px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .flag img {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    max-width: none;
    height: 30px;
    transform: translate(-50%, -50%);
  }

  /* The middle and the scoreline only group the parts; each score sits on its team's line. */
  .middle,
  .scoreline {
    display: contents;
  }

  .score {
    grid-column: 2;
    justify-self: end;
    color: var(--ink);
    font: 800 20px / 1.2 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .score.home {
    grid-row: 1;
  }

  .score.away {
    grid-row: 2;
  }

  .dash {
    display: none;
  }

  /* The other side's score steps back, so our side's reads first. */
  [data-ours='home'] .score.away,
  [data-ours='away'] .score.home {
    color: var(--ink2);
    font-weight: 600;
  }

  /* The result for our side, said softly: the score takes a light tint, never a badge. */
  [data-ours='home'][data-outcome='win'] .score.home,
  [data-ours='away'][data-outcome='win'] .score.away {
    color: color-mix(in srgb, var(--conf) 55%, var(--ink));
  }

  [data-ours='home'][data-outcome='loss'] .score.home,
  [data-ours='away'][data-outcome='loss'] .score.away {
    color: color-mix(in srgb, var(--disp) 55%, var(--ink));
  }

  /* Before the start the score column holds the time; then the scores, with the minute or the end. */
  .board[data-state='upcoming'] .score,
  .scoreline:has(.score.home:empty):has(.score.away:empty) .score {
    display: none;
  }

  .clock {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .board:not([data-state='upcoming']) .clock {
    display: none;
  }

  /* Before the start the time and its word stand together on the right, so the names keep the
     room. */
  .board[data-state='upcoming'] button.match {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .board[data-state='upcoming'] .clock {
    grid-row: 1;
    align-self: end;
    justify-self: end;
  }

  .board[data-state='upcoming'] .status {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
  }

  .status {
    display: inline-flex;
    grid-column: 3;
    grid-row: 1 / span 2;
    align-items: center;
    align-self: center;
    justify-self: end;
    gap: 2px;
  }

  .middle small {
    color: var(--meta);
    font: 500 13px / 1.3 var(--f-body);
    white-space: nowrap;
  }

  .board[data-state='on'] .middle small {
    color: var(--hot);
    font-weight: 600;
  }

  .chevron {
    display: inline-flex;
    color: var(--meta);
    transform: rotate(90deg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  [aria-expanded='true'] .chevron {
    transform: rotate(-90deg);
  }

  /* Nothing to open before a goal or a basket. */
  .board:has(.scorers:empty) .chevron {
    display: none;
  }

  .board:has([aria-expanded='false']) .scorers,
  .scorers:empty {
    display: none;
  }

  /* Who scored: the home side's in the left half, the away side's in the right half. */
  .scorers {
    display: grid;
    grid-auto-flow: row dense;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px 12px;
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .scorers li {
    display: grid;
    grid-template-columns: minmax(1.9em, max-content) minmax(0, 1fr);
    column-gap: 6px;
    align-items: baseline;
    color: var(--ink2);
    font: 500 13px / 1.35 var(--f-body);
  }

  .scorers li.home {
    grid-column: 1;
  }

  .scorers li.away {
    grid-column: 2;
  }

  .scorers li.ours {
    color: var(--ink);
    font-weight: 600;
  }

  /* An own goal is said in a soft red, whoever it counts for. */
  .scorers li.own,
  .scorers li.own .minutes,
  .scorers li.own .unit {
    color: color-mix(in srgb, var(--disp) 75%, var(--ink));
  }

  .who .unit {
    font-size: 10px;
  }

  .photo {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin: -3px 6px 0 0;
    border-radius: 50%;
    background: var(--line);
    object-fit: cover;
    object-position: top;
    vertical-align: middle;
  }

  .minutes {
    color: var(--meta);
    font: 500 13px / 1.35 var(--f-body);
    font-variant-numeric: tabular-nums;
  }

  /* An award show or anything without a scoreline: what it is, and the time on the right. */
  .show {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
  }

  .info {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .what {
    color: var(--ink2);
    font: 400 15px / 1.4 var(--f-body);
  }

  .when {
    display: grid;
    justify-items: end;
    gap: 4px;
    text-align: right;
    white-space: nowrap;
  }

  .when b {
    color: var(--ink);
    font: 800 20px / 1.15 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .when small {
    color: var(--meta);
    font: 500 13px / 1.3 var(--f-body);
  }

  [data-state='on'] .when small {
    color: var(--hot);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
