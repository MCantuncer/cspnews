---
/**
 * Share this page (docs/design/decisions/share-previews.md): on a phone the system's own share
 * sheet opens with the page's address; where there is none, the address is copied and the
 * button says so for two seconds. The address is the page's canonical one, so a shared link
 * is the same whichever language the reader used.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  label: string;
  copied: string;
  /** What the share sheet shows as the title. */
  title: string;
}

const { label, copied, title } = Astro.props;
---

<button type="button" class="share" data-share data-title={title} data-label={label} data-copied={copied}>
  <Icon name="share" size={20} />
  <span data-share-word>{label}</span>
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    const word = button.querySelector('[data-share-word]');
    const { title = '', label = '', copied = '' } = button.dataset;
    button.addEventListener('click', () => {
      const url =
        document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? location.href;
      if ('share' in navigator && matchMedia('(pointer: coarse)').matches) {
        // Closing the sheet rejects the promise; that is not an error.
        navigator.share({ title, url }).catch(() => undefined);
        return;
      }
      navigator.clipboard.writeText(url).then(
        () => {
          if (word) word.textContent = copied;
          window.setTimeout(() => {
            if (word) word.textContent = label;
          }, 2000);
        },
        () => undefined,
      );
    });
  }
</script>

<style>
  .share {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-top: 12px;
    padding: 0 6px;
    border: 0;
    background: none;
    color: var(--ink);
    font: 600 15px / 1 var(--f-body);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
</style>
