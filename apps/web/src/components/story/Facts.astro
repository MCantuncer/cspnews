---
/** The key numbers, each with where it comes from. Emphasis by weight only. */
import type { Fact } from '@cspnews/core';

interface Props {
  facts: readonly Fact[];
  heading: string;
  lang: string;
}

const { facts, heading, lang } = Astro.props;
---

<section class="facts" aria-label={heading} lang={lang}>
  {
    facts.map((fact) => (
      <div class="fact">
        <p class="value">{fact.value}</p>
        <p class="label">{fact.label}</p>
        <p class="source">{fact.source}</p>
      </div>
    ))
  }
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0 24px;
    margin-top: 32px;
    border-top: 1px solid var(--line);
  }

  .fact {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .value {
    color: var(--ink);
    font: 800 30px / 1 var(--f-head);
    font-variant-numeric: proportional-nums lining-nums;
    letter-spacing: -0.025em;
  }

  .label {
    margin-top: 8px;
    color: var(--ink);
    font: 600 16px / 1.3 var(--f-body);
  }

  .source {
    margin-top: 3px;
    color: var(--meta);
    font: 400 14px / 1.3 var(--f-body);
  }

  @media (width >= 1024px) {
    .facts {
      display: block;
      margin-top: 0;
      padding-left: 32px;
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .fact:first-child {
      padding-top: 4px;
    }

    .fact:last-child {
      border-bottom: 0;
    }
  }
</style>
