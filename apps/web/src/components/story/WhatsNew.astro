---
/**
 * What is new in a story that continues an earlier one (docs/design/decisions/story-so-far.md):
 * one labelled sentence under the headline, and, on an older story, a link to the newer report.
 */
interface Props {
  /** "New since the evening bulletin". */
  label?: string;
  news?: string;
  newer?: { href: string; title: string; label: string };
  lang: string;
}

const { label, news, newer, lang } = Astro.props;
---

{
  label && news && (
    <p class="news">
      <span class="label">{label}</span>
      <span class="text" lang={lang}>
        {news}
      </span>
    </p>
  )
}
{
  newer && (
    <p class="newer">
      <span class="label">{newer.label}</span>
      <a href={newer.href} lang={lang}>
        {newer.title}
      </a>
    </p>
  )
}

<style>
  .news,
  .newer {
    display: grid;
    gap: 4px;
    margin: 20px 0 0;
  }

  .news {
    padding-left: 16px;
    border-left: 3px solid var(--sec);
  }

  .label {
    color: color-mix(in srgb, var(--sec) 55%, var(--ink));
    font: 700 15px / 1.5 var(--f-body);
  }

  .text {
    color: var(--ink);
    font: 400 18px / 1.5 var(--f-body);
  }

  .newer a {
    color: var(--ink);
    font: 600 17px / 1.4 var(--f-body);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
