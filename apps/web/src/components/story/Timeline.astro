---
/**
 * A story's timeline on the day line: earlier values for series stories, the story's own life
 * for the rest. It starts folded as one horizontal line; the line itself opens the upright
 * list with every step (src/styles/timeline.css).
 */
import '../../styles/timeline.css';

import { EVIDENCE, evidenceWord } from '../../lib/evidence';
import { logosFor } from '../../lib/media';
import { compactStations, type Timeline, type TimelinePoint } from '../../lib/timeline';
import Icon from '../ui/Icon.astro';

interface Props {
  timeline: Timeline;
  lang: 'en' | 'tr';
}

const { timeline, lang } = Astro.props;
const across = compactStations(timeline.points);
const pointLogos = (point: TimelinePoint) => logosFor(point.sourceIds ?? [], 5);
---

<details class:list={['tl', `tl--${timeline.kind}`]}>
  <summary class="tl__toggle">
    <span class="tl__head">
      <h2 class="tl__heading">{timeline.heading}</h2>
      <Icon name="more" size={18} class="tl__chevron" />
    </span>
    <ol class="tl__across" style={`--n: ${String(across.length)}`}>
      {
        across.map((station) =>
          station.kind === 'gap' ? (
            <li class="tl__station tl__gap">
              <span class="tl__when" />
              <span class="tl__dot">+{station.hidden}</span>
            </li>
          ) : (
            <li
              class:list={[
                'tl__station',
                { tl__current: station.point.current, tl__confirmed: station.point.confirmed },
              ]}
            >
              <span class="tl__when">{station.point.when}</span>
              <span class="tl__dot" />
              <span class="tl__title">
                {station.point.label ? (
                  <span class="tl__ev" style={`--ev: var(${EVIDENCE[station.point.label].token})`}>
                    <Icon name={EVIDENCE[station.point.label].icon} size={18} />
                    <span class="tl__ev-word">{evidenceWord(station.point.label, lang)}</span>
                  </span>
                ) : (
                  station.point.title
                )}
              </span>
            </li>
          ),
        )
      }
    </ol>
  </summary>
  <ol class="tl__down">
    {
      timeline.points.map((point) => (
        <li
          class:list={[
            'tl__station',
            { tl__current: point.current, tl__confirmed: point.confirmed },
          ]}
        >
          <span class="tl__when">{point.when}</span>
          <span class="tl__dot" aria-hidden="true" />
          <span class="tl__title">
            {point.label ? (
              <span class="tl__ev" style={`--ev: var(${EVIDENCE[point.label].token})`}>
                <Icon name={EVIDENCE[point.label].icon} size={18} />
                {evidenceWord(point.label, lang)}
              </span>
            ) : (
              point.title
            )}
          </span>
          {point.detail && (
            <span class="tl__detail">
              {pointLogos(point).length > 0 && (
                <span class="tl__logos" aria-hidden="true">
                  {pointLogos(point).map((logo) => (
                    <img src={logo.src} alt="" loading="lazy" decoding="async" />
                  ))}
                </span>
              )}
              {point.detail}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</details>
