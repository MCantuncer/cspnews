---
/** The three short lines for scanning: what happened, why it matters, what's next. */
import type { StoryVersion } from '@cspnews/core';

import type { Words } from '../../lib/i18n';

interface Props {
  summary: StoryVersion['summary'];
  words: Words;
  lang: string;
}

const { summary, words, lang } = Astro.props;
const rows = [
  [words.what, summary.what],
  [words.why, summary.why],
  [words.next, summary.next],
] as const;
---

<dl class="summary">
  {
    rows.map(([term, text]) => (
      <div class="row">
        <dt>{term}</dt>
        <dd lang={lang}>{text}</dd>
      </div>
    ))
  }
</dl>

<style>
  /* A faint field in the section's hue holds the three lines together (falls back to plain
     hairlines outside a section). */
  .summary {
    margin-top: 32px;
    padding: 4px 20px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--sec) 8%, transparent);
  }

  .row {
    display: grid;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--sec) 22%, transparent);
  }

  .row:last-child {
    border-bottom: 0;
  }

  dt {
    color: color-mix(in srgb, var(--sec) 55%, var(--ink));
    font: 700 15px / 1.5 var(--f-body);
  }

  dd {
    margin: 0;
    color: var(--ink);
    font: 400 18px / 1.5 var(--f-body);
  }

  @media (width >= 720px) {
    .row {
      grid-template-columns: 140px 1fr;
      gap: 20px;
    }

    dt {
      font-size: 16px;
      line-height: 1.7;
    }
  }
</style>
