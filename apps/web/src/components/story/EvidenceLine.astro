---
/**
 * The evidence line under the headline: the mark with its word, then up to three outlets by
 * name and a count for the rest (docs/design/system.md, "Badges"). It opens the evidence
 * drawer with the camp map.
 */
import type { EvidenceLabel, InterfaceLanguage } from '../../lib/evidence';
import { evidenceSummary } from '../../lib/i18n';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  label: EvidenceLabel;
  outlets: readonly string[];
  developing: boolean;
  lang: InterfaceLanguage;
  developingWord: string;
  /** "Updated 19:05", shown when the story changed after it was published. */
  updated?: string | undefined;
  /** The id of the evidence drawer this line opens. */
  drawerId: string;
  openLabel: string;
}

const { label, outlets, developing, lang, developingWord, updated, drawerId, openLabel } =
  Astro.props;
const SHOWN = 3;
const shown = outlets.slice(0, SHOWN);
const rest = outlets.length - shown.length;
---

<button
  type="button"
  class="evidence"
  popovertarget={drawerId}
  aria-label={`${evidenceSummary(label, outlets, SHOWN, lang)}. ${openLabel}`}
>
  <span aria-hidden="true" class="mark"><EvidenceMark label={label} lang={lang} /></span>
  <span aria-hidden="true" class="outlets">
    {shown.join(', ')}
    {rest > 0 && <span class="rest">+{rest}</span>}
  </span>
  <Icon name="more" size={18} class="chevron" />
</button>
{
  (developing || updated) && (
    <p class="status">
      {developing && (
        <span class="developing">
          <Icon name="developing" size={20} />
          {developingWord}
        </span>
      )}
      {updated && (
        <span class="updated">
          <Icon name="updated" size={20} />
          {updated}
        </span>
      )}
    </p>
  )
}

<style>
  .evidence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    min-height: 44px;
    margin: 12px 0 0 -8px;
    padding: 6px 8px;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--ink);
    font: 600 15px / 1.4 var(--f-body);
    text-align: left;
    cursor: pointer;
  }

  .evidence:hover {
    background: var(--surf);
  }

  .mark :global(.ev) {
    font-size: 15px;
  }

  .rest {
    margin-left: 6px;
    color: var(--meta);
  }

  .evidence :global(.chevron) {
    color: var(--meta);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin-top: 8px;
    color: var(--ink);
    font: 600 15px / 1.4 var(--f-body);
  }

  .developing,
  .updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .developing :global(.icon) {
    color: var(--hot);
  }

  .updated {
    color: var(--meta);
    font-weight: 500;
  }
</style>
