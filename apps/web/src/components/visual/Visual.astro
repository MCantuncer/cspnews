---
/**
 * A story's one visual (docs/design/decisions/visuals.md). `full` sits on the story page with
 * its credit; `wide` is the same 16:9 picture without a caption, for a section's lead in
 * Contents; `thumb` is the small square beside every other row.
 */
import type { InterfaceLanguage } from '../../lib/evidence';
import { wordsFor } from '../../lib/i18n';
import { locatorMap } from '../../lib/map';
import { formatValue, type Visual } from '../../lib/visual';

interface Props {
  visual: Visual;
  lang: InterfaceLanguage;
  /** The story's language, for numbers and captions taken from the story. */
  storyLang: 'en' | 'tr';
  size?: 'full' | 'wide' | 'thumb';
}

const { visual, lang, storyLang, size = 'full' } = Astro.props;
const words = wordsFor(lang);
const thumb = size === 'thumb';
const captioned = size === 'full';

const W = thumb ? 64 : 640;
const H = thumb ? 64 : 360;
const map =
  visual.kind === 'map' ? locatorMap(visual.place, W, H, thumb ? 1400 : 900) : undefined;

// Chart: two bars from zero, so the change is shown at its true size.
const chart =
  visual.kind === 'chart'
    ? (() => {
        const { before, after, unit } = visual.keyNumber;
        const max = Math.max(Math.abs(before), Math.abs(after)) || 1;
        return [
          { label: words.before, value: before, text: formatValue(before, unit, storyLang), now: false },
          { label: words.now, value: after, text: formatValue(after, unit, storyLang), now: true },
        ].map((bar) => ({ ...bar, share: Math.abs(bar.value) / max }));
      })()
    : undefined;
---

{
  visual.kind !== 'none' && (
    <figure class:list={['visual', `is-${visual.kind}`, size]}>
      {visual.kind === 'photo' && (
        <img
          src={visual.src}
          alt=""
          width={W}
          height={H}
          loading={captioned ? 'eager' : 'lazy'}
          decoding="async"
        />
      )}

      {visual.kind === 'chart' &&
        chart &&
        (thumb ? (
          <svg viewBox="0 0 64 64" aria-hidden="true">
            {chart.map((bar, i) => (
              <rect
                x={14 + i * 22}
                y={54 - bar.share * 40}
                width="14"
                height={bar.share * 40}
                class:list={['bar', { now: bar.now }]}
              />
            ))}
            <path d="M8 54.5h48" class="axis" />
          </svg>
        ) : (
          <div class="chart" lang={storyLang}>
            <p class="chart-label">{visual.keyNumber.label}</p>
            {chart.map((bar) => (
              <div class:list={['row', { now: bar.now }]}>
                <span class="when">{bar.label}</span>
                <span class="track">
                  <span class="fill" style={`width: ${String(bar.share * 100)}%`} />
                </span>
                <span class="value">{bar.text}</span>
              </div>
            ))}
          </div>
        ))}

      {visual.kind === 'map' && map && (
        <svg
          viewBox={`0 0 ${String(W)} ${String(H)}`}
          role={thumb ? undefined : 'img'}
          aria-hidden={thumb ? 'true' : undefined}
          aria-label={thumb ? undefined : `${visual.place.name}, ${visual.place.region}`}
        >
          <rect width={W} height={H} class="sea" />
          {map.land.map((shape) => (
            <path d={shape.d} class:list={['land', { home: shape.home }]} />
          ))}
          <circle cx={map.x} cy={map.y} r={thumb ? 7 : 16} class="ring" />
          <circle cx={map.x} cy={map.y} r={thumb ? 3 : 6} class="dot" />
        </svg>
      )}

      {visual.kind === 'logo' && (
        <span class="logo-box">
          <img src={visual.src} alt="" loading="lazy" decoding="async" />
        </span>
      )}

      {captioned && (
        <figcaption>
          {visual.kind === 'photo' && (
            <>
              {words.photo}:{' '}
              <a href={visual.image.articleUrl} rel="noopener noreferrer">
                {visual.image.sourceName}
              </a>
            </>
          )}
          {visual.kind === 'chart' && <span lang={storyLang}>{visual.keyNumber.source}</span>}
          {visual.kind === 'map' && (
            <span lang={storyLang}>
              {visual.place.name}, {visual.place.region}
            </span>
          )}
          {visual.kind === 'logo' && words.logo}
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .visual {
    margin: 0;
  }

  img,
  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .full img,
  .full.is-map svg,
  .wide img,
  .wide.is-map svg {
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background: var(--surf);
    object-fit: cover;
  }

  .thumb {
    width: 64px;
    height: 64px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surf);
  }

  .thumb img,
  .thumb svg {
    width: 64px;
    height: 64px;
    object-fit: cover;
  }

  figcaption {
    margin-top: 8px;
    color: var(--meta);
    font: 400 14px / 1.4 var(--f-body);
  }

  figcaption a {
    color: var(--ink);
    text-underline-offset: 3px;
  }

  /* Map */
  .sea {
    fill: var(--sea);
  }

  .land {
    fill: var(--land);
    stroke: var(--line2);
    stroke-width: 0.75;
    stroke-linejoin: round;
  }

  .land.home {
    fill: var(--land-hi);
    stroke: var(--meta);
  }

  .ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .dot {
    fill: var(--ink);
  }

  /* Chart */
  .chart {
    display: grid;
    gap: 12px;
    padding: 20px;
    border-radius: 6px;
    background: var(--surf);
  }

  .chart-label {
    color: var(--ink);
    font: 600 15px / 1.3 var(--f-body);
  }

  .row {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: center;
    gap: 12px;
  }

  .when {
    color: var(--meta);
    font: 500 14px / 1 var(--f-body);
  }

  .track {
    height: 14px;
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--line2);
  }

  .now .fill {
    background: var(--ink);
  }

  .value {
    min-width: 4.5ch;
    color: var(--meta);
    font: 700 18px / 1 var(--f-head);
    font-variant-numeric: proportional-nums lining-nums;
    text-align: right;
  }

  .now .value {
    color: var(--ink);
    font-size: 22px;
  }

  .bar {
    fill: var(--line2);
  }

  .bar.now {
    fill: var(--ink);
  }

  .axis {
    stroke: var(--meta);
    stroke-width: 1;
  }

  /* Logo: the mark on a quiet panel, never stretched. */
  .logo-box {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 24px;
    border-radius: 6px;
    background: var(--surf);
  }

  .logo-box img {
    width: auto;
    max-width: 60%;
    max-height: 100%;
    object-fit: contain;
  }

  .thumb .logo-box {
    aspect-ratio: 1;
    padding: 8px;
  }

  .thumb .logo-box img {
    width: auto;
    height: auto;
    max-width: 100%;
  }
</style>
