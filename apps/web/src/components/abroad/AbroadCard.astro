---
/**
 * One person in the Turks abroad station on Contents (docs/design/decisions/turks-abroad.md):
 * a card with the person's picture and club crest (or their sport in a ring when neither is saved), their name and where they play, then what
 * they did, laid out for the sport (the numbers, the score or the milestone), the line on it and
 * when it happened in our time.
 */
import { teamKey, type LocalAbroadItem } from '@cspnews/core';

import {
  KIND_ICON,
  MILESTONE_ICON,
  abroadWords,
  clubOf,
  statStrip,
  whenLine,
} from '../../lib/abroad';
import type { InterfaceLanguage } from '../../lib/evidence';
import { photoUrl, teamLogoUrl } from '../../lib/media';
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  item: LocalAbroadItem;
  href: string;
  publishAt: string;
  lang: InterfaceLanguage;
}

const { item, href, publishAt, lang } = Astro.props;
const words = abroadWords(lang);
const photo = item.image ? photoUrl(item.id) : undefined;
const crest = teamLogoUrl(teamKey(clubOf(item.where)));
const when = whenLine(item, publishAt, lang);
const strip = item.stats ? statStrip(item.stats, lang) : [];
const milestone = !item.stats && item.milestoneType && item.milestone ? item.milestone : undefined;
const result = item.score !== undefined || strip.length > 0 || milestone !== undefined;
---

<a class="card" href={href} lang={item.language}>
  <span class="head">
    {
      photo || crest ? (
        <span class:list={['pic', { crest: !photo }]} aria-hidden="true">
          <img src={photo ?? crest} alt="" loading="lazy" decoding="async" />
          {photo && crest && (
            <span class="badge">
              <img src={crest} alt="" loading="lazy" decoding="async" />
            </span>
          )}
        </span>
      ) : (
        <span class="pic field" aria-hidden="true">
          <Icon name={KIND_ICON[item.kind]} size={30} />
        </span>
      )
    }
    <span class="who">
      <span class="name">{item.person}</span>
      <span class="where">
        {(photo || crest) && <Icon name={KIND_ICON[item.kind]} size={16} />}
        <span>{item.where}</span>
      </span>
      {item.rising && <span class="rising">{words.rising}</span>}
    </span>
  </span>
  {
    result && (
      <span class="result">
        {item.score && <span class="score">{item.score}</span>}
        {strip.length > 0 && (
          <span class:list={['strip', { tennis: item.stats?.sport === 'tennis' }]}>
            {strip.map((cell) => (
              <span class="cell">
                <b>{cell.value}</b>
                {cell.label && <span>{cell.label}</span>}
              </span>
            ))}
          </span>
        )}
        {milestone && item.milestoneType && (
          <span class="milestone">
            <span class="type">
              <Icon name={MILESTONE_ICON[item.milestoneType]} size={16} />
              {words.milestones[item.milestoneType]}
            </span>
            <span class="milestone-name">{milestone.name}</span>
          </span>
        )}
      </span>
    )
  }
  <span class="title">{item.title}</span>
  <span class="foot">
    <EvidenceMark label={item.label} lang={lang} variant="glyph" />
    {when && <span>{when}</span>}
  </span>
</a>

<style>
  /* A quiet surface, no shadow: the picture and the result carry it. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
    padding: 18px 16px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surf);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--sec) 45%, var(--line));
  }

  .card:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* The person, round; a club crest sits on its edge when Tonight has saved one. */
  .pic {
    position: relative;
    flex: none;
    width: 72px;
    height: 72px;
  }

  .pic > img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* No photo of the person: the crest itself, whole, on the page colour. */
  .pic.crest {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
  }

  .pic.crest > img {
    width: 44px;
    height: 44px;
    border-radius: 0;
    object-fit: contain;
  }

  /* No picture saved: the sport or field as a station, a ring in the section colour. */
  .pic.field {
    display: grid;
    place-items: center;
    border: 2px solid var(--sec);
    border-radius: 50%;
    color: var(--sec);
  }

  .badge {
    position: absolute;
    right: -4px;
    bottom: -4px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 2px solid var(--surf);
    border-radius: 50%;
    background: #fff;
  }

  .badge img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .name {
    font: 800 21px / 1.15 var(--f-head);
    letter-spacing: -0.015em;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--meta);
    font: 400 15px / 1.3 var(--f-body);
  }

  .where :global(svg) {
    flex: none;
    color: var(--sec);
  }

  .rising {
    color: var(--sec);
    font: 600 15px / 1.3 var(--f-body);
  }

  /* What they did, set apart by one hairline: the score, the numbers or the milestone. */
  .result {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .score {
    color: var(--ink);
    font: 700 16px / 1.3 var(--f-head);
    font-variant-numeric: tabular-nums;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }

  .cell {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--meta);
    font: 400 15px / 1.2 var(--f-body);
  }

  .cell b {
    color: var(--ink);
    font: 800 22px / 1 var(--f-head);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  /* Small phones keep a box score on one line. */
  @media (width < 420px) {
    .strip {
      column-gap: 12px;
    }

    .cell {
      gap: 5px;
      font-size: 14px;
    }

    .cell b {
      font-size: 20px;
    }
  }

  .strip.tennis b {
    font-size: 22px;
    word-spacing: 6px;
  }

  .milestone {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .type {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sec);
    font: 600 15px / 1.3 var(--f-body);
  }

  .milestone-name {
    color: var(--ink);
    font: 700 17px / 1.3 var(--f-head);
  }

  .title {
    color: var(--ink2);
    font: 400 17px / 1.45 var(--f-body);
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    color: var(--meta);
    font: 400 15px / 1.3 var(--f-body);
  }
</style>
