---
import type { InterfaceLanguage } from '../lib/evidence';
import { wordsFor } from '../lib/i18n';
import { localePath } from '../lib/locale';
import { currentPlace, placeLinks } from '../lib/places';
import ReaderCorner from './ReaderCorner.astro';
import Icon from './ui/Icon.astro';

/**
 * The header on every screen: the wordmark, then the bulletin name (which will open Contents),
 * over the day line. The edition hour colours the 3px top edge (docs/design/system.md).
 * With `progress`, the day line shows how far the reader is through the bulletin. The reader
 * corner (src/components/ReaderCorner.astro) sits at the right end: settings and the account.
 * The header stays at the top while the page scrolls, so the reader never has to scroll back up
 * to reach Contents or the reader corner. Its height is shared as --header-h, so other sticky
 * parts (the Contents rail) and anchor jumps sit below it.
 */
interface Props {
  /** The interface language; links stay on the reader's side of the site. */
  lang?: InterfaceLanguage;
  bulletinName?: string;
  /** A second line under the bulletin name, such as "Tech and AI, 5 of 12". */
  detail?: string;
  /** Reading position through the bulletin, from 0 to 1. */
  progress?: number;
  /** Where the bulletin name leads: the bulletin's Contents. */
  contentsHref?: string;
  contentsLabel?: string;
  /** True on the Settings page, where the reader corner carries the hour mark. */
  inSettings?: boolean;
}

const {
  lang = 'en',
  bulletinName,
  detail,
  progress,
  contentsHref,
  contentsLabel,
  inSettings = false,
} = Astro.props;
const words = wordsFor(lang);
const here = currentPlace(Astro.url.pathname);
const places = placeLinks(lang);
// While a reader is inside a bulletin or story, the day line shows their progress instead.
const showPlaces = progress === undefined;
const position = progress === undefined ? undefined : Math.min(1, Math.max(0, progress));
---

<header class="header">
  <div class="bar">
    <a class="wordmark" href={localePath('/', lang)} aria-label={words.home}><b>CSP</b>News</a>
    {
      bulletinName &&
        (contentsHref ? (
          <a
            class="bulletin link"
            href={contentsHref}
            aria-label={`${contentsLabel ?? bulletinName}: ${bulletinName}${detail ? `, ${detail}` : ''}`}
          >
            <Icon name="contents" size={22} class="contents-icon" />
            <span class="lines">
              <span class="name">{bulletinName}</span>
              {detail && <span class="detail">{detail}</span>}
            </span>
          </a>
        ) : (
          <p class="bulletin">
            <span class="lines">
              <span class="name">{bulletinName}</span>
              {detail && <span class="detail">{detail}</span>}
            </span>
          </p>
        ))
    }
    {
      showPlaces && (
        <nav class="places wide" aria-label={words.places}>
          {places.map((place) => (
            <a href={place.href} aria-current={place.key === here ? 'page' : undefined}>
              {place.label}
            </a>
          ))}
        </nav>
      )
    }
    <ReaderCorner lang={lang} inSettings={inSettings} />
  </div>
  {
    showPlaces && (
      <nav class="places narrow" aria-label={words.places}>
        {places.map((place) => (
          <a href={place.href} aria-current={place.key === here ? 'page' : undefined}>
            {place.label}
          </a>
        ))}
      </nav>
    )
  }
  <div
    class="dayline"
    aria-hidden="true"
    style={position === undefined ? undefined : `--at: ${String(position * 100)}%`}
  >
    {
      position !== undefined && (
        <>
          <span class="read" />
          <span class="here" />
        </>
      )
    }
  </div>
</header>

<script>
  // Share the header's height (it grows with a detail line and the notch) with the rest of the page.
  const header = document.querySelector<HTMLElement>('header.header');
  if (header) {
    const root = document.documentElement;
    const share = () => {
      root.style.setProperty('--header-h', `${String(header.offsetHeight)}px`);
    };
    share();
    if ('ResizeObserver' in window) new ResizeObserver(share).observe(header);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 3;
    background: var(--bg);
    border-top: 3px solid var(--hour);
    padding: 0 var(--gutter) 4px;
    padding-top: env(safe-area-inset-top);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 60px;
  }

  .wordmark {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font: 700 20px / 1 var(--f-head);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark b {
    font-weight: 800;
  }

  .bulletin {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .link {
    min-height: 48px;
    margin-left: -8px;
    padding: 2px 8px;
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }

  .link:hover {
    background: var(--surf);
  }

  .link :global(.contents-icon) {
    color: var(--ink);
  }

  .lines {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .name {
    color: var(--meta);
    font: 500 13px / 1.2 var(--f-body);
  }

  .lines .name:only-child {
    color: var(--ink);
    font: 600 15px / 1.2 var(--f-body);
  }

  .detail {
    overflow: hidden;
    color: var(--ink);
    font: 700 15px / 1.2 var(--f-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dayline {
    position: relative;
    height: 1px;
    background: var(--line2);
  }

  .read {
    position: absolute;
    top: -0.5px;
    left: 0;
    width: var(--at);
    height: 2px;
    background: var(--ink);
  }

  .here {
    position: absolute;
    top: -2.5px;
    left: clamp(0px, calc(var(--at) - 9px), calc(100% - 18px));
    width: 18px;
    height: 6px;
    border-radius: 1px;
    background: var(--hour);
  }
  /* Where to go: News, Music, Word. Beside the bar on wide screens; on phones its own row, the
     current place underlined on the day line. */
  .places {
    display: flex;
    gap: 24px;
  }

  .places a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--meta);
    font: 500 15px / 1 var(--f-body);
    text-decoration: none;
  }

  .places a:hover {
    color: var(--ink);
  }

  .places a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  .narrow {
    position: relative;
    z-index: 1;
    margin: -6px 0 -1px;
  }

  .narrow a {
    min-height: 40px;
    border-bottom: 2px solid transparent;
  }

  .narrow a[aria-current='page'] {
    border-color: var(--ink);
  }

  .wide {
    display: none;
  }

  @media (width >= 900px) {
    .narrow {
      display: none;
    }

    .wide {
      display: flex;
      margin-left: auto;
    }

    .wide a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 8px;
    }

    .bar:has(.wide) :global(.rc-button) {
      margin-left: 12px;
    }
  }
</style>
