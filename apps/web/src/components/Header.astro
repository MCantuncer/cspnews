---
/**
 * The header on every screen: the wordmark, then the bulletin name (which will open Contents),
 * over the day line. The edition hour colours the 3px top edge (docs/design/system.md).
 * With `progress`, the day line shows how far the reader is through the bulletin.
 */
interface Props {
  bulletinName?: string;
  /** A second line under the bulletin name, such as "Tech and AI, 5 of 12". */
  detail?: string;
  /** Reading position through the bulletin, from 0 to 1. */
  progress?: number;
}

const { bulletinName, detail, progress } = Astro.props;
const position = progress === undefined ? undefined : Math.min(1, Math.max(0, progress));
---

<header class="header">
  <div class="bar">
    <a class="wordmark" href="/" aria-label="CSPNews, home"><b>CSP</b>News</a>
    {
      bulletinName && (
        <p class="bulletin">
          <span class="name">{bulletinName}</span>
          {detail && <span class="detail">{detail}</span>}
        </p>
      )
    }
  </div>
  <div
    class="dayline"
    aria-hidden="true"
    style={position === undefined ? undefined : `--at: ${String(position * 100)}%`}
  >
    {
      position !== undefined && (
        <>
          <span class="read" />
          <span class="here" />
        </>
      )
    }
  </div>
</header>

<style>
  .header {
    border-top: 3px solid var(--hour);
    padding: 0 var(--gutter);
    padding-top: env(safe-area-inset-top);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 60px;
  }

  .wordmark {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font: 700 20px / 1 var(--f-head);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark b {
    font-weight: 800;
  }

  .bulletin {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .name {
    color: var(--meta);
    font: 500 13px / 1.2 var(--f-body);
  }

  .bulletin .name:only-child {
    color: var(--ink);
    font: 600 15px / 1.2 var(--f-body);
  }

  .detail {
    overflow: hidden;
    color: var(--ink);
    font: 700 15px / 1.2 var(--f-body);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dayline {
    position: relative;
    height: 1px;
    background: var(--line2);
  }

  .read {
    position: absolute;
    top: -0.5px;
    left: 0;
    width: var(--at);
    height: 2px;
    background: var(--ink);
  }

  .here {
    position: absolute;
    top: -2.5px;
    left: clamp(0px, calc(var(--at) - 9px), calc(100% - 18px));
    width: 18px;
    height: 6px;
    border-radius: 1px;
    background: var(--hour);
  }
</style>
