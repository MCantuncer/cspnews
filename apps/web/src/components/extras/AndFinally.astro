---
/**
 * And finally (docs/design/decisions/and-finally.md): the bulletin's light close, one quiet fold
 * after the last section. Closed, it is one line with a teaser and a row of small badges, one per
 * item, so the reader sees what is inside. Open, the items run down a short line of their own,
 * each led by its badge (what it is about) and its kind: the light stories (told straight, with
 * one line of wit marked by the hour rule) and the backstage rumours, whose badges are dashed,
 * each with who is saying it. A native <details>, so it opens without script; it opens by itself
 * when the page is reached through `#and-finally`. Readers who turn light stories off never see it.
 */
import EvidenceMark from '../ui/EvidenceMark.astro';
import Icon from '../ui/Icon.astro';
import type { PublishedBulletin } from '../../lib/bulletins';
import type { InterfaceLanguage } from '../../lib/evidence';
import {
  AND_FINALLY_ID,
  LIGHT_KIND_ICON,
  andFinallyIn,
  extrasWords,
  kindWord,
} from '../../lib/extras';
import { wordsFor } from '../../lib/i18n';
import { logosFor, photoUrl } from '../../lib/media';
import { sourceName } from '../../lib/sources';

interface Props {
  published: PublishedBulletin;
  lang: InterfaceLanguage;
}

const { published, lang } = Astro.props;
const close = andFinallyIn(published, lang);
const words = extrasWords(lang);
const teaser = close?.light[0]?.title ?? close?.rumours[0]?.title;
const badges = close
  ? [
      ...close.light.map((story) => ({ kind: story.kind, rumour: false })),
      ...close.rumours.map((rumour) => ({ kind: rumour.kind, rumour: true })),
    ]
  : [];
const logoOf = (sourceId: string) => logosFor([sourceId], 1)[0];
// The outlet photo, when the run saved one: the first light story with a photo leads with it
// across the column, the others show it small beside the title.
const light = (close?.light ?? []).map((story) => ({
  story,
  photo: story.image ? photoUrl(story.id) : undefined,
}));
const leadId = light.find((item) => item.photo)?.story.id;
---

{
  close && (
    <li class="close" id={AND_FINALLY_ID} data-and-finally>
      <details>
        <summary>
          <Icon name="light" size={22} class="close-mark" />
          <span class="head">
            <b>
              {words.andFinally}
              <span class="count">{words.count(close.count)}</span>
            </b>
            {teaser && <span class="teaser">{teaser}</span>}
            <span class="badges" aria-hidden="true">
              {badges.map((badge) => (
                <span class:list={['badge', 'small', { rumour: badge.rumour }]}>
                  <Icon name={LIGHT_KIND_ICON[badge.kind]} size={16} />
                </span>
              ))}
            </span>
          </span>
          <Icon name="more" size={18} class="close-chevron" />
        </summary>
        <p class="note">{words.note}</p>
        <div class="body">
          {close.light.length > 0 && (
            <ul class="items">
              {light.map(({ story, photo }) => (
                <li
                  class:list={['item', { lead: story.id === leadId, thumbed: photo && story.id !== leadId }]}
                  lang={story.language}
                >
                  <span class="badge" aria-hidden="true">
                    <Icon name={LIGHT_KIND_ICON[story.kind]} size={22} />
                  </span>
                  <div class="text">
                    {photo && story.id === leadId && (
                      <img class="photo" src={photo} alt="" loading="lazy" decoding="async" />
                    )}
                    <p class="kind">{kindWord(story.kind, lang)}</p>
                    <h3>{story.title}</h3>
                    <p class="gist">{story.gist}</p>
                    <p class="aside">{story.aside}</p>
                    <p class="meta">
                      <EvidenceMark label={story.label} lang={lang} variant="glyph" />
                      {story.sources.map((source) => {
                        const logo = logoOf(source.sourceId);
                        return (
                          <a class="outlet" href={source.url} rel="noopener">
                            {logo && <img src={logo.src} alt="" loading="lazy" decoding="async" />}
                            {sourceName(source.sourceId)}
                          </a>
                        );
                      })}
                    </p>
                    {story.image && photo && (
                      <p class="credit">{`${wordsFor(lang).photo}: ${story.image.sourceName}`}</p>
                    )}
                  </div>
                  {photo && story.id !== leadId && (
                    <img class="thumb" src={photo} alt="" loading="lazy" decoding="async" />
                  )}
                </li>
              ))}
            </ul>
          )}
          {close.rumours.length > 0 && (
            <section class="backstage" aria-labelledby={`${AND_FINALLY_ID}-backstage`}>
              <h3 class="backstage-title" id={`${AND_FINALLY_ID}-backstage`}>
                <Icon name="rumour" size={20} />
                {words.backstage}
              </h3>
              <p class="backstage-note">{words.backstageNote}</p>
              <ul class="items">
                {close.rumours.map((rumour) => {
                  const logo = logoOf(rumour.heardFrom.sourceId);
                  return (
                    <li class="item" lang={rumour.language}>
                      <span class="badge rumour" aria-hidden="true">
                        <Icon name={LIGHT_KIND_ICON[rumour.kind]} size={22} />
                      </span>
                      <div class="text">
                        <p class="kind">
                          {kindWord(rumour.kind, lang)}, {words.rumour.toLocaleLowerCase(lang)}
                        </p>
                        <p class="title">{rumour.title}</p>
                        <p class="meta">
                          <span>{words.heardFrom}</span>
                          <a class="outlet" href={rumour.heardFrom.url} rel="noopener">
                            {logo && <img src={logo.src} alt="" loading="lazy" decoding="async" />}
                            {sourceName(rumour.heardFrom.sourceId)}
                          </a>
                        </p>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </div>
      </details>
    </li>
  )
}

<script>
  // Arriving from the caught-up screen (…#and-finally) opens the fold.
  const close = document.querySelector<HTMLElement>('li[data-and-finally]');
  const fold = close?.querySelector('details');
  if (close && fold && location.hash === `#${close.id}`) fold.open = true;
</script>

<style>
  .close {
    position: relative;
    padding-top: 30px;
    list-style: none;
  }

  /* Its own quiet station on the day line, in the hour colour. */
  .close::before {
    position: absolute;
    top: 53px;
    left: -35px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--hour);
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 4px var(--bg);
    content: '';
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--hour);
    outline-offset: 4px;
  }

  /* The station already marks it on the upright line; the cup shows on the flat one. */
  summary :global(.close-mark) {
    display: none;
    color: var(--hour);
  }

  .head {
    display: grid;
    gap: 4px;
  }

  .head b {
    color: var(--ink);
    font: 700 17px / 1.3 var(--f-body);
  }

  .count {
    margin-left: 6px;
    color: var(--meta);
    font-weight: 400;
  }

  .teaser {
    color: var(--ink2);
    font: 400 15px / 1.4 var(--f-body);
  }

  summary :global(.close-chevron) {
    flex: none;
    margin-left: auto;
    color: var(--meta);
    transition: transform var(--dur-base) var(--ease-out);
  }

  details[open] summary {
    border-bottom: 0;
  }

  details[open] .teaser,
  details[open] .badges {
    display: none;
  }

  details[open] summary :global(.close-chevron) {
    transform: rotate(90deg);
  }

  /* One badge per item: what it is about, in a soft field of the hour colour. Rumours get a
     dashed outline instead, the same dashes as their evidence glyph. */
  .badges {
    display: flex;
    gap: 6px;
    margin-top: 6px;
  }

  .badge {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--hour) 14%, var(--bg));
    color: var(--hour);
  }

  .badge.small {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .badge.rumour {
    border: 1.75px dashed var(--line2);
    background: none;
    color: var(--meta);
  }

  .note {
    max-width: 52ch;
    margin-bottom: 6px;
    color: var(--meta);
    font: 400 15px / 1.5 var(--f-body);
  }

  /* The items run down a short line of their own, badge to badge, so the eye has one path. */
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 0 18px;
  }

  .item + .item::before {
    position: absolute;
    top: -14px;
    left: 21px;
    width: 2px;
    height: 28px;
    background: color-mix(in srgb, var(--hour) 35%, var(--line));
    content: '';
  }

  .item.thumbed {
    grid-template-columns: 44px minmax(0, 1fr) 72px;
  }

  .text {
    min-width: 0;
  }

  /* A real photo is the strongest pull to read: the lead one runs across the column. */
  .photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 12px;
    border-radius: 10px;
    background: var(--surf);
    object-fit: cover;
  }

  .thumb {
    width: 72px;
    height: 72px;
    margin-top: 18px;
    border-radius: 8px;
    background: var(--surf);
    object-fit: cover;
  }

  .credit {
    margin-top: 6px;
    color: var(--meta2);
    font: 400 12px / 1.3 var(--f-body);
  }

  .kind {
    color: var(--hour);
    font: 700 13px / 1.2 var(--f-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .backstage .kind {
    color: var(--meta);
  }

  h3,
  .title {
    margin-top: 4px;
    color: var(--ink);
    font: 600 17px / 1.3 var(--f-body);
  }

  .gist {
    margin-top: 6px;
    color: var(--meta);
    font: 400 15px / 1.5 var(--f-body);
  }

  /* Our one line of wit, the punchline: set apart in the headline face, so the facts and the
     joke never blur. */
  .aside {
    margin-top: 10px;
    padding-left: 12px;
    border-left: 2px solid var(--hour);
    color: var(--ink);
    font: 700 16px / 1.35 var(--f-head);
    letter-spacing: -0.005em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 10px;
    color: var(--meta);
    font: 400 14px / 1.35 var(--f-body);
  }

  .outlet {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink2);
    font-weight: 600;
    text-decoration: none;
  }

  .outlet:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Logos are drawn for white, so they sit on white in both themes. */
  .outlet img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #fff;
    object-fit: contain;
  }

  .backstage {
    margin-top: 6px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .backstage-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 0;
    font: 800 18px / 1.2 var(--f-head);
    letter-spacing: -0.01em;
  }

  .backstage-title :global(svg) {
    color: var(--meta);
  }

  .backstage-note {
    margin-top: 4px;
    color: var(--meta);
    font: 400 14px / 1.4 var(--f-body);
  }

  .backstage .items {
    margin-top: 4px;
    border-bottom: 1px solid var(--line);
  }

  .backstage .item + .item::before {
    background: var(--line);
  }

  .backstage .title {
    font-size: 16px;
  }

  /* On the flat day line it runs under the section columns: light stories on the left, the
     backstage talk beside them. */
  @media (width >= 1400px) {
    .close {
      grid-column: 1 / -1;
      padding-top: 44px;
    }

    .close::before {
      display: none;
    }

    summary :global(.close-mark) {
      display: block;
    }

    details[open] .body {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      column-gap: 56px;
    }

    .body > .items {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-content: start;
      column-gap: 56px;
    }

    .body > .items > .item::before {
      display: none;
    }

    .backstage {
      margin-top: 0;
      padding-top: 14px;
      border-top: 0;
    }

    .backstage .items {
      border-bottom: 0;
    }

    h3 {
      font-size: 19px;
    }
  }
</style>
